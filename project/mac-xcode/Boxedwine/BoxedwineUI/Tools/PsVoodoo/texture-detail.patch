+void CTMU::DetailTexelScale(float *constants)
+{
+    // Glide computes LOD in its 256-texel coordinate space, before mip selection.
+    constants[0] = m_source.m_defined ? m_source.m_ufactor * m_xscale : 256.0f;
+    constants[1] = m_source.m_defined ? m_source.m_vfactor * m_yscale : 256.0f;
+    constants[2] = constants[3] = 0;
+}
