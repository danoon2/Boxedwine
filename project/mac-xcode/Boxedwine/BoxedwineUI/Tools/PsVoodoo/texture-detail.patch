+void CCombine::grTexDetailControl(GrChipID_t tmu, int bias, FxU8 scale, float maximum)
+{
+    if(tmu != GR_TMU0) return;
+    // The public Glide values are bias [-32,31], scale [0,7], maximum [0,1].
+    m_detail_control[0] = float(bias < -32 ? -32 : (bias > 31 ? 31 : bias));
+    m_detail_control[1] = float(1U << (scale & 7)) / 255.0f;
+    m_detail_control[2] = maximum < 0 ? 0 : (maximum > 1 ? 1 : maximum);
+}
