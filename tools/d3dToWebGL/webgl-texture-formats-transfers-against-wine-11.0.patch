+
+    elapsed_us = wined3d_texture_gl_profile_now_us() - start_us;
+    fprintf(stderr, "BOXEDWINE_WEBGL_READPIXELS wine.%s width=%u height=%u pixels=%u elapsed_us=%llu format=%u\n",
+            name, width, height, width * height, (unsigned long long)elapsed_us, format_id);
