+        WORD *dst_line = (WORD *)(dst + y * pitch_out);
+
+        for (x = 0; x < w; ++x)
+        {
+            WORD pixel = src_line[x];
+
+            dst_line[x] = ((pixel & 0x7c00u) << 1)
+                    | ((pixel & 0x03e0u) << 1) | ((pixel & 0x0200u) >> 4)
+                    | (pixel & 0x001fu);
+        }
+    }
