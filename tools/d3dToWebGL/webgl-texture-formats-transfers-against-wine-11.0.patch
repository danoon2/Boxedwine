+
+static inline DWORD x8r8g8b8_from_a1r5g5b5(WORD pixel)
+{
+    BYTE r = (pixel >> 10) & 0x1f;
+    BYTE g = (pixel >> 5) & 0x1f;
+    BYTE b = pixel & 0x1f;
+
+    return (pixel & 0x8000 ? 0xff000000u : 0)
+            | ((r << 3) | (r >> 2)) << 16
+            | ((g << 3) | (g >> 2)) << 8
+            | ((b << 3) | (b >> 2));
+}
+
+static inline WORD a1r5g5b5_from_x8r8g8b8(DWORD pixel)
+{
+    return (pixel & 0x80000000u ? 0x8000u : 0)
+            | ((pixel >> 9) & 0x7c00u)
+            | ((pixel >> 6) & 0x03e0u)
+            | ((pixel >> 3) & 0x001fu);
+}
