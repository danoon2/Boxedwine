+static void convert_yv12_x8r8g8b8(const BYTE *src, BYTE *dst,
+        unsigned int pitch_in, unsigned int pitch_out, unsigned int w, unsigned int h)
+{
+    const BYTE *v_plane = src + pitch_in * h;
+    const BYTE *u_plane = v_plane + (pitch_in / 2) * (h / 2);
+    unsigned int x, y;
+
+    TRACE("Converting %ux%u pixels, pitches %u %u.\n", w, h, pitch_in, pitch_out);
+
+    for (y = 0; y < h; ++y)
+    {
+        const BYTE *y_line = src + y * pitch_in;
+        const BYTE *u_line = u_plane + (y / 2) * (pitch_in / 2);
+        const BYTE *v_line = v_plane + (y / 2) * (pitch_in / 2);
+        DWORD *dst_line = (DWORD *)(dst + y * pitch_out);
+
+        for (x = 0; x < w; ++x)
+            dst_line[x] = yuv_to_x8r8g8b8(y_line[x], u_line[x / 2], v_line[x / 2]);
+    }
+}
