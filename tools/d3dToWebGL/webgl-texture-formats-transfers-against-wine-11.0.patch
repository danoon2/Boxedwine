+        case WINED3DFMT_R8G8B8A8_SNORM:
+        case WINED3DFMT_R16G16_SNORM:
+            format_clear_caps(format, WINED3D_FORMAT_CAP_TEXTURE
+                    | WINED3D_FORMAT_CAP_POSTPIXELSHADER_BLENDING
+                    | WINED3D_FORMAT_CAP_FILTERING
+                    | WINED3D_FORMAT_CAP_DECOMPRESS);
+            break;
+
+        case WINED3DFMT_UYVY:
+        case WINED3DFMT_YUY2:
+        case WINED3DFMT_YV12:
+        case WINED3DFMT_NV12:
+        case WINED3DFMT_NV12_PLANAR:
+            format_clear_caps(format, WINED3D_FORMAT_CAP_BLIT);
+            break;
+
+        default:
+            break;
+    }
+}
