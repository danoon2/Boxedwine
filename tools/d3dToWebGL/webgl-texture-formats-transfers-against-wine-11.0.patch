+static void convert_r5g6b5_a1r5g5b5(const BYTE *src, BYTE *dst,
+        unsigned int pitch_in, unsigned int pitch_out, unsigned int w, unsigned int h)
+{
+    unsigned int x, y;
+
+    TRACE("Converting %ux%u pixels, pitches %u %u.\n", w, h, pitch_in, pitch_out);
+
+    for (y = 0; y < h; ++y)
+    {
+        const WORD *src_line = (const WORD *)(src + y * pitch_in);
+        WORD *dst_line = (WORD *)(dst + y * pitch_out);
+
+        for (x = 0; x < w; ++x)
+        {
+            WORD pixel = src_line[x];
+
+            dst_line[x] = 0x8000u | ((pixel & 0xf800u) >> 1)
+                    | ((pixel & 0x07c0u) >> 1) | (pixel & 0x001fu);
+        }
+    }
+}
+
+static void convert_a1r5g5b5_r5g6b5(const BYTE *src, BYTE *dst,
+        unsigned int pitch_in, unsigned int pitch_out, unsigned int w, unsigned int h)
+{
+    unsigned int x, y;
