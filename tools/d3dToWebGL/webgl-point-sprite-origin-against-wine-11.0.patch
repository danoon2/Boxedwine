+static const char *shader_glsl_point_sprite_texcoord(void)
+{
+    /* WebGL cannot select the lower-left origin used by the desktop GL path. */
+    return wined3d_settings.webgl
+            ? "vec4(gl_PointCoord.x, 1.0 - gl_PointCoord.y, 0.0, 0.0)"
+            : "vec4(gl_PointCoord.xy, 0.0, 0.0)";
 }
 
