index 0000000..f6be68e
--- /dev/null
+++ b/build-boxedwine-webgl-dlls.sh
@@ -0,0 +1,180 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+    cat <<'EOF'
+Usage: ./build-boxedwine-webgl-dlls.sh [options]
+
+Build true Win32 Wine DLLs for BoxedWine WebGL.
+
+Options:
+  --build-dir DIR   Build/output directory.
+                    Default: ../boxedwine-webgl-wine-build
+  --jobs N          Parallel make jobs. Default: detected CPU count.
+  --help            Show this help.
+
+Outputs:
+  DIR/boxedwine-webgl-dlls/{d3d8,d3d9,ddraw,dxgi,d3dx9_36,d3dx9_43,d3dxof,wined3d}.dll
+  DIR/boxedwine-webgl-tests/{d3d8,d3d9,ddraw,d3dx9_43,d3dxof}_test.exe
+EOF
+}
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+build_dir="$(cd "$script_dir/.." && pwd)/boxedwine-webgl-wine-build"
+jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 1)"
+SOURCE_DATE_EPOCH=1768319767
+export SOURCE_DATE_EPOCH
+
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --build-dir)
+            if [ "$#" -lt 2 ]; then
+                echo "error: --build-dir requires a value" >&2
+                exit 2
+            fi
+            build_dir="$2"
+            shift 2
+            ;;
+        --jobs)
+            if [ "$#" -lt 2 ]; then
+                echo "error: --jobs requires a value" >&2
+                exit 2
+            fi
+            jobs="$2"
+            shift 2
+            ;;
+        --help|-h)
+            usage
+            exit 0
+            ;;
+        *)
+            echo "error: unknown option '$1'" >&2
+            usage >&2
+            exit 2
+            ;;
+    esac
+done
+
+case "$jobs" in
+    ''|*[!0-9]*)
+        echo "error: --jobs must be a positive integer" >&2
+        exit 2
+        ;;
+    0)
+        echo "error: --jobs must be greater than zero" >&2
+        exit 2
+        ;;
+esac
+
+require_tool() {
+    if ! command -v "$1" >/dev/null 2>&1; then
+        echo "error: required tool '$1' was not found in PATH" >&2
+        exit 1
+    fi
+}
+
+require_tool make
+require_tool gcc
+require_tool i686-w64-mingw32-gcc
+require_tool i686-w64-mingw32-objdump
+require_tool sha256sum
+require_tool strings
+
+wine_tools_dir="$build_dir/wine-tools"
+wine_win32_dir="$build_dir/wine-win32"
+output_dir="$build_dir/boxedwine-webgl-dlls"
+tests_output_dir="$build_dir/boxedwine-webgl-tests"
+
+echo "Wine source: $script_dir"
+echo "Build dir:   $build_dir"
+echo "Jobs:        $jobs"
+
+mkdir -p "$wine_tools_dir" "$wine_win32_dir" "$output_dir" "$tests_output_dir"
+
+echo
+echo "Configuring native Wine tools..."
+(
+    cd "$wine_tools_dir"
+    "$script_dir/configure" --without-x --without-freetype
+)
+
+echo
+echo "Building native Wine tools..."
+make -C "$wine_tools_dir" -j"$jobs" __tooldeps__
+
+echo
+echo "Configuring true Win32 DLL build..."
+(
+    cd "$wine_win32_dir"
+    "$script_dir/configure" \
+        --without-x \
+        --disable-kernel32 \
+        --without-freetype \
+        --host=i686-w64-mingw32 \
+        CFLAGS="-O3 -DWINE_NO_DEBUG_MSGS -DWINE_NOWINSOCK -DUSE_WIN32_OPENGL -DUSE_WIN32_VULKAN -ffile-prefix-map=$script_dir=/usr/src/wine" \
+        --with-wine-tools="$wine_tools_dir/" \
+        LDFLAGS=" -static-libgcc -Wl,--no-insert-timestamp"
+)
+
+echo
+echo "Building DLLs and tests..."
+make -C "$wine_win32_dir" -j"$jobs" \
+    dlls/wined3d/wined3d.dll \
+    dlls/d3d9/d3d9.dll \
+    dlls/d3d8/d3d8.dll \
+    dlls/ddraw/ddraw.dll \
+    dlls/dxgi/dxgi.dll \
+    dlls/d3dx9_36/d3dx9_36.dll \
+    dlls/d3dx9_43/d3dx9_43.dll \
+    dlls/d3dxof/d3dxof.dll \
+    dlls/d3d9/tests/d3d9_test.exe \
+    dlls/d3d8/tests/d3d8_test.exe \
+    dlls/ddraw/tests/ddraw_test.exe \
+    dlls/d3dx9_43/tests/d3dx9_43_test.exe \
+    dlls/d3dxof/tests/d3dxof_test.exe
+
+echo
+echo "Copying DLLs to $output_dir..."
+cp -f "$wine_win32_dir/dlls/wined3d/wined3d.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/d3d9/d3d9.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/d3d8/d3d8.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/ddraw/ddraw.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/dxgi/dxgi.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/d3dx9_36/d3dx9_36.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/d3dx9_43/d3dx9_43.dll" "$output_dir/"
+cp -f "$wine_win32_dir/dlls/d3dxof/d3dxof.dll" "$output_dir/"
+
+echo
+echo "Copying tests to $tests_output_dir..."
+cp -f "$wine_win32_dir/dlls/d3d9/tests/d3d9_test.exe" "$tests_output_dir/"
+cp -f "$wine_win32_dir/dlls/d3d8/tests/d3d8_test.exe" "$tests_output_dir/"
+cp -f "$wine_win32_dir/dlls/ddraw/tests/ddraw_test.exe" "$tests_output_dir/"
+cp -f "$wine_win32_dir/dlls/d3dx9_43/tests/d3dx9_43_test.exe" "$tests_output_dir/"
+cp -f "$wine_win32_dir/dlls/d3dxof/tests/d3dxof_test.exe" "$tests_output_dir/"
+
+echo
+echo "DLL build output:"
+for dll in d3d8.dll d3d9.dll ddraw.dll dxgi.dll d3dx9_36.dll d3dx9_43.dll d3dxof.dll wined3d.dll; do
+    path="$output_dir/$dll"
+    printf "%-14s %10s " "$dll" "$(stat -c %s "$path")"
+    sha256sum "$path" | awk '{print $1}'
+done
+
+echo
+echo "Test build output:"
+for test in d3d8_test.exe d3d9_test.exe ddraw_test.exe d3dx9_43_test.exe d3dxof_test.exe; do
+    path="$tests_output_dir/$test"
+    printf "%-20s %10s " "$test" "$(stat -c %s "$path")"
+    sha256sum "$path" | awk '{print $1}'
+done
+
+echo
+if strings "$output_dir/d3d9.dll" | grep -q "Wine builtin DLL"; then
+    echo "warning: d3d9.dll contains 'Wine builtin DLL'; this is not the expected true Win32 output." >&2
+else
+    echo "Sanity check passed: d3d9.dll does not contain 'Wine builtin DLL'."
+fi
+
+echo
+echo "d3d9.dll imports:"
+i686-w64-mingw32-objdump -p "$output_dir/d3d9.dll" | grep "DLL Name" || true
