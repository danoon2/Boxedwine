+static void ddraw_surface_get_overlay_frontbuffer_rect(struct ddraw_surface *overlay, RECT *dst_rect)
+{
+    POINT p;
+
+    *dst_rect = overlay->overlay_dst_rect;
+
+    /* The WebGL swapchain renders directly into the browser canvas, whose
+     * coordinates already match the primary surface. Translating through the
+     * host desktop window would move the overlay outside the destination. */
+    if (ddraw_webgl_enabled() || !overlay->ddraw->dest_window)
+        return;
+    p.x = 0;
+    p.y = 0;
+    ClientToScreen(overlay->ddraw->dest_window, &p);
+    OffsetRect(dst_rect, -p.x, -p.y);
+}
