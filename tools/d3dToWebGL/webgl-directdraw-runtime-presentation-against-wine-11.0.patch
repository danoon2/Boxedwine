+        else
+            present_rect = ddraw->webgl_frontbuffer_dirty;
+    }
+    else if (rect)
+    {
+        present_rect = *rect;
+    }
+    else
+    {
+        return DD_OK;
+    }
+
+    profile_start = ddraw_profile_enabled() ? ddraw_profile_now_us() : 0;
+    if (SUCCEEDED(hr = wined3d_swapchain_present(ddraw->wined3d_swapchain,
+            &present_rect, &present_rect, NULL, swap_interval, 0)))
+    {
+        ddraw->webgl_frontbuffer_dirty_valid = FALSE;
+        ddraw->webgl_frontbuffer_dirty_count = 0;
+        ddraw->webgl_last_present_time = GetTickCount();
+        ddraw->flags |= DDRAW_SWAPPED;
+    }
+    ddraw_profile_record(&profile_bucket, "ddraw_present_frontbuffer", profile_start,
+            ddraw_profile_rect_pixels(&present_rect), swap_interval);
+
+    return hr;
+}
