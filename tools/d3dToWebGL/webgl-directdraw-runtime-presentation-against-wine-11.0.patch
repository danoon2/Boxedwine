+    struct ddraw_surface *overlay;
+    HRESULT hr;
+
+    if (!dst_surface || !(dst_surface->surface_desc.ddsCaps.dwCaps & DDSCAPS_PRIMARYSURFACE))
+        return DD_OK;
+
+    LIST_FOR_EACH_ENTRY_REV(overlay, &dst_surface->ddraw->overlay_z_order_list,
+            struct ddraw_surface, overlay_z_order_entry)
+    {
+        if (overlay->overlay_visible && overlay->overlay_dst_surface == dst_surface
+                && FAILED(hr = ddraw_surface_blt_overlay_to_texture(overlay, dst_texture)))
