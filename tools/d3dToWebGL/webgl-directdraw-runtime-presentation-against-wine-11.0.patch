+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv("BOXEDWINE_WEBGL_BLTFAST_LOCKS");
+        enabled = value && value[0] && strcmp(value, "0");
+    }
+
+    return enabled;
+}
