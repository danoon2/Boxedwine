+static HRESULT ddraw_streaming_buffer_upload_vertices(struct d3d_device *device,
+        const void *vertices, UINT size, UINT stride, DWORD fvf, UINT *vb_pos)
+{
+    BOOL fixup_zero_rhw = ddraw_webgl_enabled() && (fvf & D3DFVF_POSITION_MASK) == D3DFVF_XYZRHW;
+    void *dst_data;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!fixup_zero_rhw)
+        return wined3d_streaming_buffer_upload(device->wined3d_device,
+                &device->vertex_buffer, vertices, size, stride, vb_pos);
+
+    if (FAILED(hr = wined3d_streaming_buffer_map(device->wined3d_device,
+            &device->vertex_buffer, size, stride, vb_pos, &dst_data)))
+        return hr;
+
+    /* WebGL drops pretransformed vertices with RHW 0; native ddraw treats them as visible. */
+    memcpy(dst_data, vertices, size);
+    for (i = 0; i < size / stride; ++i)
+    {
+        float *position = (float *)((BYTE *)dst_data + i * stride);
+
+        if (position[3] == 0.0f)
+            position[3] = 1.0f;
+    }
+
+    wined3d_streaming_buffer_unmap(&device->vertex_buffer);
+    return D3D_OK;
+}
