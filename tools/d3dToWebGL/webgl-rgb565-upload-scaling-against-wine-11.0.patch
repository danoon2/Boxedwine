+#ifdef __SSE2__
+/* Compact four RGBA byte lanes to twelve RGB bytes without overwriting the row. */
+static inline void wined3d_texture_gl_store_webgl_rgb4(uint8_t *dst, __m128i rgba)
+{
+    /* Each 64-bit lane becomes R G B R G B 0 0. */
+    __m128i pairs = _mm_or_si128(_mm_and_si128(rgba, _mm_set_epi32(0, 0x00ffffff, 0, 0x00ffffff)),
+            _mm_srli_epi64(_mm_and_si128(rgba, _mm_set_epi32(0x00ffffff, 0, 0x00ffffff, 0)), 8));
+    __m128i packed = _mm_or_si128(_mm_unpacklo_epi64(pairs, _mm_setzero_si128()),
+            _mm_srli_si128(_mm_unpackhi_epi64(_mm_setzero_si128(), pairs), 2));
+    uint32_t tail;
+
+    _mm_storel_epi64((__m128i *)dst, packed);
+    tail = _mm_cvtsi128_si32(_mm_srli_si128(packed, 8));
+    memcpy(dst + 8, &tail, sizeof(tail));
+}
+#endif
