diff --git a/dlls/wined3d/buffer.c b/dlls/wined3d/buffer.c
index f7a59d3..a0b53a3 100644
--- a/dlls/wined3d/buffer.c
+++ b/dlls/wined3d/buffer.c
@@ -32,6 +32,9 @@ WINE_DEFAULT_DEBUG_CHANNEL(d3d);
 #define WINED3D_BUFFER_USE_BO       0x02    /* Use a buffer object for this buffer. */
 
 #define SB_MIN_SIZE (512 * 1024)    /* Minimum size of an allocated streaming buffer. */
+/* In WebGL, writing to a buffer that a pending draw still uses costs time in
+ * proportion to the size of the whole buffer, so keep streaming buffers small. */
+#define SB_WEBGL_MIN_SIZE (256 * 1024)
 
 struct wined3d_buffer_ops
 {
@@ -1380,7 +1383,7 @@ static HRESULT wined3d_streaming_buffer_prepare(struct wined3d_device *device,
             return S_OK;
     }
 
-    size = max(wined3d_settings.webgl ? 16 * 1024 * 1024 : SB_MIN_SIZE, max(old_size * 2, min_size));
+    size = max(wined3d_settings.webgl ? SB_WEBGL_MIN_SIZE : SB_MIN_SIZE, max(old_size * 2, min_size));
     TRACE("Growing buffer to %u bytes.\n", size);
 
     desc.byte_width = size;
