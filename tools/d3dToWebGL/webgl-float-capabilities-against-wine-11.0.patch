     {"GL_ATI_texture_mirror_once",          ATI_TEXTURE_MIRROR_ONCE       },
 
     /* EXT */
+    {"GL_EXT_color_buffer_float",          EXT_COLOR_BUFFER_FLOAT        },
+    {"GL_EXT_color_buffer_half_float",     EXT_COLOR_BUFFER_HALF_FLOAT   },
+    {"GL_EXT_float_blend",                 EXT_FLOAT_BLEND               },
+    {"GL_OES_texture_float_linear",        OES_TEXTURE_FLOAT_LINEAR      },
     {"GL_EXT_blend_color",                  EXT_BLEND_COLOR               },
     {"GL_EXT_blend_equation_separate",      EXT_BLEND_EQUATION_SEPARATE   },
     {"GL_EXT_blend_func_separate",          EXT_BLEND_FUNC_SEPARATE       },
diff --git a/dlls/wined3d/wined3d_gl.h b/dlls/wined3d/wined3d_gl.h
