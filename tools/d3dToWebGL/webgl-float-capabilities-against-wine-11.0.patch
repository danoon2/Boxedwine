@@ -236,6 +236,12 @@
     WINED3D_GL_VERSION_3_2,
     WINED3D_GLSL_130,
 
+    /* WebGL capability-only extensions; no additional entry points. */
+    EXT_COLOR_BUFFER_FLOAT,
+    EXT_COLOR_BUFFER_HALF_FLOAT,
+    EXT_FLOAT_BLEND,
