 }
 
 /* Context activation is done by the caller. */
+/* Eight 16 KiB blocks fit the minimum OpenGL 3.1 uniform block size and expose
+ * all 8192 D3D9 software vertex constants, including relative addressing. */
+static bool shader_glsl_uses_swvp_constants(const struct wined3d_shader *shader, const struct wined3d_gl_info *gl_info)
+{
+    return gl_info->supported[ARB_UNIFORM_BUFFER_OBJECT]
+            && gl_info->limits.uniform_blocks[WINED3D_SHADER_TYPE_VERTEX] >= 8
+            && shader->reg_maps.shader_version.type == WINED3D_SHADER_TYPE_VERTEX
+            && shader->limits->constant_float == WINED3D_MAX_VS_CONSTS_F_SWVP;
+}
+
+/* Keep the usual low registers on Wine's sparse uniform upload path. Leave
+ * space for all integer/boolean constants, clip planes and fixup uniforms. */
+static unsigned int shader_glsl_swvp_uniform_count(const struct wined3d_gl_info *gl_info)
+{
+    unsigned int reserved = WINED3D_MAX_CONSTS_I + WINED3D_MAX_CONSTS_B
+            + gl_info->limits.user_clip_distances + gl_info->reserved_glsl_constants + 3;
+    unsigned int available = gl_info->limits.glsl_vs_float_constants;
+
+    return available > reserved ? min(available - reserved, WINED3D_MAX_VS_CONSTS_F) : 0;
+}
+
+static void shader_glsl_load_swvp_constants(struct wined3d_context_gl *context_gl,
+        struct wined3d_buffer *constant_buffer)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct glsl_context_data *data = context_gl->c.shader_backend_data;
+    const struct wined3d_vec4 *constants = constant_buffer
+            ? wined3d_buffer_load_sysmem(constant_buffer, &context_gl->c) : NULL;
+    struct wined3d_range range;
+    unsigned int base, count, i, start;
+
+    if (!context_gl->swvp_constants)
+    {
+        GL_EXTCALL(glGenBuffers(1, &context_gl->swvp_constants));
+        GL_EXTCALL(glBindBuffer(GL_UNIFORM_BUFFER, context_gl->swvp_constants));
+        GL_EXTCALL(glBufferData(GL_UNIFORM_BUFFER, WINED3D_MAX_VS_CONSTS_F_SWVP * sizeof(*constants),
+                constants, GL_DYNAMIC_DRAW));
+    }
+    else if (constants && data->swvp_dirty_end)
+    {
+        GL_EXTCALL(glBindBuffer(GL_UNIFORM_BUFFER, context_gl->swvp_constants));
+        for (start = 0; wined3d_bitmap_get_range(data->swvp_dirty,
+                data->swvp_dirty_end, start, &range); start = range.offset + range.size)
+            GL_EXTCALL(glBufferSubData(GL_UNIFORM_BUFFER, range.offset * sizeof(*constants),
+                    range.size * sizeof(*constants), constants + range.offset));
+    }
+    memset(data->swvp_dirty, 0, WINED3D_BITMAP_SIZE(data->swvp_dirty_end) * sizeof(*data->swvp_dirty));
+    data->swvp_dirty_end = 0;
+    if (!context_gl->swvp_constants_bound)
+    {
+        wined3d_gl_limits_get_uniform_block_range(&gl_info->limits, WINED3D_SHADER_TYPE_VERTEX, &base, &count);
+        for (i = 0; i < 8; ++i)
+            GL_EXTCALL(glBindBufferRange(GL_UNIFORM_BUFFER, base + i, context_gl->swvp_constants,
+                    i * 16384, 16384));
+        context_gl->swvp_constants_bound = true;
+    }
+    checkGLcall("software vertex constants");
+}
