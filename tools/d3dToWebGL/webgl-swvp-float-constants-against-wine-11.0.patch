 static void shader_glsl_load_constants_f(const struct wined3d_shader *shader, struct wined3d_context_gl *context_gl,
         struct wined3d_buffer *constant_buffer, const GLint *constant_locations, const struct constant_heap *heap,
         unsigned char *stack, unsigned int version)
@@ -1461,6 +1522,15 @@ static void shader_glsl_load_constants_f(const struct wined3d_shader *shader, st
     const struct wined3d_gl_info *gl_info = context_gl->gl_info;
     const struct wined3d_shader_lconst *lconst;
 
+    if (shader_glsl_uses_swvp_constants(shader, gl_info))
+    {
+        shader_glsl_load_swvp_constants(context_gl, constant_buffer);
+        if (constant_buffer)
+            walk_constant_heap(gl_info, wined3d_buffer_load_sysmem(constant_buffer, &context_gl->c),
+                    constant_locations, heap, stack, version);
+        return;
+    }
+
     if (constant_buffer)
     {
         const struct wined3d_vec4 *constants = wined3d_buffer_load_sysmem(constant_buffer, &context_gl->c);
@@ -1482,7 +1552,9 @@ static void shader_glsl_load_constants_f(const struct wined3d_shader *shader, st
     /* Immediate constants are clamped to [-1;1] at shader creation time if needed */
     LIST_FOR_EACH_ENTRY(lconst, &shader->constantsF, struct wined3d_shader_lconst, entry)
     {
-        GL_EXTCALL(glUniform4fv(constant_locations[lconst->idx], 1, (const GLfloat *)lconst->value));
+        if (lconst->idx < (shader->reg_maps.shader_version.type == WINED3D_SHADER_TYPE_VERTEX
+                ? WINED3D_MAX_VS_CONSTS_F : WINED3D_MAX_PS_CONSTS_F))
+            GL_EXTCALL(glUniform4fv(constant_locations[lconst->idx], 1, (const GLfloat *)lconst->value));
     }
     checkGLcall("glUniform4fv()");
 }
@@ -2160,9 +2232,25 @@ static void shader_glsl_update_float_vertex_constants(struct wined3d_device *dev
 {
     struct shader_glsl_priv *priv = device->shader_priv;
     struct constant_heap *heap = &priv->vconst_heap;
-    UINT i;
+    unsigned int i, j;
 
-    for (i = start; i < count + start; ++i)
+    /* Each GL context owns its upload buffer and may miss draws made on other
+     * contexts. Keep dirty ranges until that context next loads constants. */
+    for (i = 0; i < device->context_count; ++i)
+    {
+        struct glsl_context_data *data = device->contexts[i]->shader_backend_data;
+        if (!wined3d_context_gl(device->contexts[i])->swvp_constants)
+            continue;
+        j = max(start, shader_glsl_swvp_uniform_count(wined3d_context_gl(device->contexts[i])->gl_info));
+        if (j < min(count + start, WINED3D_MAX_VS_CONSTS_F_SWVP))
+        {
+            for (; j < min(count + start, WINED3D_MAX_VS_CONSTS_F_SWVP); ++j)
+                wined3d_bitmap_set(data->swvp_dirty, j);
+            data->swvp_dirty_end = max(data->swvp_dirty_end, WINED3D_BITMAP_SIZE(j) * 32);
+        }
+    }
+
+    for (i = start; i < min(count + start, WINED3D_MAX_VS_CONSTS_F); ++i)
     {
         update_heap_entry(heap, i, priv->next_constant_version);
     }
@@ -2537,8 +2625,32 @@ static void shader_generate_glsl_declarations(const struct wined3d_context_gl *c
             shader_addline(buffer, "invariant gl_Position;\n");
     }
 
-    /* Declare the constants (aka uniforms) */
-    if (shader->limits->constant_float > 0)
+    /* Declare the constants (aka uniforms). Legacy shaders do not otherwise
+     * use the vertex stage's uniform-buffer binding range. */
+    if (shader_glsl_uses_swvp_constants(shader, gl_info))
+    {
+        unsigned int uniform_count = shader_glsl_swvp_uniform_count(gl_info);
+        if (uniform_count)
+            shader_addline(buffer, "uniform vec4 vs_c[%u];\n", uniform_count);
+        for (i = 0; i < 8; ++i)
+            shader_addline(buffer, "layout(std140) uniform swvp_block%u { vec4 swvp_c%u[1024]; };\n", i, i);
+        shader_addline(buffer, "vec4 swvp_read(int index) {\n");
+        shader_addline(buffer, "if (index < 0 || index >= 8192) return vec4(0.0);\n");
+        /* Resolve shader-local defs here, including relative reads. The UBO
+         * then contains only application constants and survives shader switches. */
+        LIST_FOR_EACH_ENTRY(lconst, &shader->constantsF, struct wined3d_shader_lconst, entry)
+        {
+            shader_addline(buffer, "if (index == %u) return ", lconst->idx);
+            shader_glsl_append_imm_vec(buffer, (const float *)lconst->value, ARRAY_SIZE(lconst->value), gl_info);
+            shader_addline(buffer, ";\n");
+        }
+        if (uniform_count)
+            shader_addline(buffer, "if (index < %u) return vs_c[index];\n", uniform_count);
+        for (i = 0; i < 8; ++i)
+            shader_addline(buffer, "if (index < %u) return swvp_c%u[index %% 1024];\n", (i + 1) * 1024, i);
+        shader_addline(buffer, "return vec4(0.0); }\n");
+    }
+    else if (shader->limits->constant_float > 0)
     {
         unsigned max_constantsF;
 
@@ -3124,6 +3236,16 @@ static void shader_glsl_get_register_name(const struct wined3d_shader_register *
 
         case WINED3DSPR_CONST:
             {
