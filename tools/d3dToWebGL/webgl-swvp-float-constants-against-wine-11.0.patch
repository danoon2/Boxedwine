@@ -10570,6 +10692,11 @@ static void shader_glsl_init_vs_uniform_locations(const struct wined3d_gl_info *
     unsigned int i;
     struct wined3d_string_buffer *name = string_buffer_get(&priv->string_buffers);
 
+    /* Only the low registers use individual uniforms on the SWVP path. */
