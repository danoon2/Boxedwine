 static void shader_glsl_update_legacy_states(struct wined3d_context_gl *context_gl, const struct wined3d_state *state);
 
+static BOOL shader_glsl_needs_webgl_sample_mask(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state)
+{
+    const struct wined3d_resource *resource = NULL;
+    unsigned int i, samples, mask;
+
+    if (!shader_glsl_use_webgl_glsl_es(context_gl->gl_info)
+            || !context_gl->gl_info->supported[OES_SAMPLE_VARIABLES])
+        return FALSE;
+
+    for (i = 0; i < WINED3D_MAX_RENDER_TARGETS; ++i)
+    {
+        if (state->fb.render_targets[i])
+        {
+            resource = state->fb.render_targets[i]->resource;
+            break;
+        }
+    }
+    if (!resource && state->fb.depth_stencil)
+        resource = state->fb.depth_stencil->resource;
+    if (!resource || resource->multisample_type < WINED3D_MULTISAMPLE_2_SAMPLES)
+        return FALSE;
+
+    samples = resource->multisample_type;
+    mask = wined3d_mask_from_size(samples);
+    /* Preserve normal alpha-to-coverage when all actual samples are enabled. */
+    return (state->sample_mask & mask) != mask;
+}
