+static void wined3d_adapter_apply_webgl_gl_info(struct wined3d_gl_info *gl_info)
+{
+    static const enum wined3d_gl_extension desktop_only_extensions[] =
+    {
+        ARB_CLIP_CONTROL,
+        ARB_COLOR_BUFFER_FLOAT,
+        ARB_BUFFER_STORAGE,
+        ARB_COMPUTE_SHADER,
+        ARB_DEPTH_CLAMP,
+        ARB_DRAW_INDIRECT,
+        ARB_FRAGMENT_PROGRAM,
+        ARB_FRAGMENT_PROGRAM_SHADOW,
+        ARB_FRAMEBUFFER_SRGB,
+        ARB_GEOMETRY_SHADER4,
+        ARB_INTERNALFORMAT_QUERY,
+        ARB_INTERNALFORMAT_QUERY2,
+        ARB_MAP_BUFFER_ALIGNMENT,
+        ARB_MAP_BUFFER_RANGE,
+        ARB_PIPELINE_STATISTICS_QUERY,
+        ARB_PIXEL_BUFFER_OBJECT,
+        ARB_POLYGON_OFFSET_CLAMP,
+        ARB_PROVOKING_VERTEX,
+        ARB_QUERY_BUFFER_OBJECT,
+        ARB_SEAMLESS_CUBE_MAP,
+        ARB_SHADER_ATOMIC_COUNTERS,
+        ARB_SHADER_IMAGE_LOAD_STORE,
+        ARB_SHADER_IMAGE_SIZE,
+        ARB_SHADER_STORAGE_BUFFER_OBJECT,
+        ARB_SHADER_TEXTURE_IMAGE_SAMPLES,
+        ARB_TESSELLATION_SHADER,
+        ARB_TEXTURE_BORDER_CLAMP,
+        ARB_TEXTURE_BUFFER_OBJECT,
+        ARB_TEXTURE_BUFFER_RANGE,
+        ARB_TEXTURE_CUBE_MAP_ARRAY,
+        ARB_TEXTURE_MIRROR_CLAMP_TO_EDGE,
+        ARB_TEXTURE_MULTISAMPLE,
+        ARB_TEXTURE_STORAGE_MULTISAMPLE,
+        ARB_TEXTURE_VIEW,
+        ARB_TIMER_QUERY,
+        ARB_VIEWPORT_ARRAY,
+        ARB_VERTEX_PROGRAM,
+        APPLE_FLUSH_BUFFER_RANGE,
+        ATI_FRAGMENT_SHADER,
+        ATI_TEXTURE_MIRROR_ONCE,
+        EXT_TEXTURE_LOD_BIAS,
+        EXT_TEXTURE_MIRROR_CLAMP,
+        EXT_PROVOKING_VERTEX,
+        NV_FRAGMENT_PROGRAM,
+        NV_FRAGMENT_PROGRAM2,
+        NV_FRAGMENT_PROGRAM_OPTION,
+        NV_REGISTER_COMBINERS,
+        NV_REGISTER_COMBINERS2,
+        NV_TEXTURE_SHADER,
+        NV_TEXTURE_SHADER2,
+        NV_VERTEX_PROGRAM,
+        NV_VERTEX_PROGRAM1_1,
+        NV_VERTEX_PROGRAM2,
+        NV_VERTEX_PROGRAM2_OPTION,
+        NV_VERTEX_PROGRAM3,
+    };
+    unsigned int i;
+
+    TRACE("Applying WebGL-compatible GL extension clamp.\n");
+
+    for (i = 0; i < ARRAY_SIZE(desktop_only_extensions); ++i)
+        gl_info->supported[desktop_only_extensions[i]] = FALSE;
+
+    gl_info->supported[WINED3D_GL_LEGACY_CONTEXT] = FALSE;
+}
