diff --git a/dlls/wined3d/utils.c b/dlls/wined3d/utils.c
--- a/dlls/wined3d/utils.c
+++ b/dlls/wined3d/utils.c
@@ -2265,8 +2265,9 @@
         case WINED3DFMT_B5G6R5_UNORM:
             format->internal = GL_RGB565;
             format->srgb_internal = GL_RGB565;
-            if (!format->rt_internal)
-                format->rt_internal = GL_RGB565;
+            /* WebGL multisample resolves require identical storage formats.
+             * Discard the desktop RGB8 render-target fallback. */
+            format->rt_internal = GL_RGB565;
             format->format = GL_RGB;
             format->type = GL_UNSIGNED_BYTE;
             break;
