diff --git a/dlls/wined3d/texture_gl.c b/dlls/wined3d/texture_gl.c
index d0749c23bd1..fec5aa8e6ff 100644
--- a/dlls/wined3d/texture_gl.c
+++ b/dlls/wined3d/texture_gl.c
@@ -2378,6 +2378,31 @@ static bool wined3d_texture_gl_read_pixels_webgl_color(const struct wined3d_gl_i
             return false;
     }
 
+    /* WebGL permits the implementation's native read pair in addition to
+     * RGBA/UNSIGNED_BYTE. Query the bound framebuffer, since its storage may
+     * differ from the requested D3D format, and keep the portable fallback. */
+    if (format->id == WINED3DFMT_B5G6R5_UNORM && !(row_pitch % 2))
+    {
+        GLint read_format, read_type, alignment, row_length;
+
+        gl_info->gl_ops.gl.p_glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_FORMAT, &read_format);
+        gl_info->gl_ops.gl.p_glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE, &read_type);
+        if (read_format == GL_RGB && read_type == GL_UNSIGNED_SHORT_5_6_5)
+        {
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, row_pitch / 2);
+            profile_start = wined3d_profile_enabled() ? wined3d_profile_now_us() : 0;
+            gl_info->gl_ops.gl.p_glReadPixels(0, 0, width, height, GL_RGB, GL_UNSIGNED_SHORT_5_6_5, dst);
+            wined3d_texture_gl_profile_readpixels("texture_gl_webgl_rgb565_readpixels", profile_start,
+                    width, height, format->id);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+            return true;
+        }
+    }
+
     if (!(rgba = malloc(pixel_count * 4)))
     {
         ERR("Failed to allocate readback memory.\n");
@@ -2390,6 +2415,47 @@ static bool wined3d_texture_gl_read_pixels_webgl_color(const struct wined3d_gl_i
             packed_rgb10 ? GL_UNSIGNED_INT_2_10_10_10_REV : GL_UNSIGNED_BYTE, rgba);
     wined3d_texture_gl_profile_readpixels("texture_gl_webgl_rgba8_readpixels", profile_start,
             width, height, format->id);
+    /* These common layouts use a dedicated row loop so each pixel does not
+     * repeat the format dispatch or load four separate byte components. */
+    if (format->id == WINED3DFMT_B5G6R5_UNORM)
+    {
+        for (y = 0; y < height; ++y)
+        {
+            const uint32_t *src_row = (const uint32_t *)(rgba + y * width * 4);
+            uint16_t *dst_row = (uint16_t *)(dst + y * row_pitch);
+
+            for (x = 0; x < width; ++x)
+            {
+                uint32_t v = src_row[x];
+                dst_row[x] = ((v & 0xf8) << 8) | ((v & 0xfc00) >> 5) | ((v >> 19) & 0x1f);
+            }
+        }
+        goto done;
+    }
+    if (format->id == WINED3DFMT_B8G8R8A8_UNORM || format->id == WINED3DFMT_B8G8R8A8_UNORM_SRGB
+            || format->id == WINED3DFMT_B8G8R8X8_UNORM || format->id == WINED3DFMT_B8G8R8X8_UNORM_SRGB)
+    {
+        for (y = 0; y < height; ++y)
+        {
+            const uint32_t *src_row = (const uint32_t *)(rgba + y * width * 4);
+            uint32_t *dst_row = (uint32_t *)(dst + y * row_pitch);
+
+            for (x = 0; x < width; ++x)
+            {
+                uint32_t v = src_row[x];
+                dst_row[x] = (v & 0xff00ff00) | ((v >> 16) & 0xff) | ((v & 0xff) << 16);
+            }
+        }
+        goto done;
+    }
+    if (format->id == WINED3DFMT_R8G8B8A8_UNORM || format->id == WINED3DFMT_R8G8B8A8_UNORM_SRGB
+            || format->id == WINED3DFMT_R8G8B8X8_UNORM)
+    {
+        for (y = 0; y < height; ++y)
+            memcpy(dst + y * row_pitch, rgba + y * width * 4, width * 4);
+        goto done;
+    }
+
     for (y = 0; y < height; ++y)
     {
         uint8_t *dst_row = dst + y * row_pitch;
@@ -2478,6 +2544,7 @@ static bool wined3d_texture_gl_read_pixels_webgl_color(const struct wined3d_gl_i
         }
     }
 
+done:
     free(rgba);
     return true;
 }
