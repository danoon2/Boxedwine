+/* The result is a state decision, independent of enabled diagnostic channels. */
+BOOL shader_glsl_validate_link(const struct wined3d_gl_info *gl_info, GLuint program)
+{
+    GLint linked = GL_FALSE;
+
+    GL_EXTCALL(glGetProgramiv(program, GL_LINK_STATUS, &linked));
+    if (!linked)
+    {
+        ERR("GLSL program %u link status invalid.\n", program);
+        shader_glsl_dump_failure_log(gl_info, program, TRUE);
+        shader_glsl_dump_program_source(gl_info, program);
+    }
+    else
+        print_glsl_info_log(gl_info, program, TRUE);
+    return linked;
 }
 
