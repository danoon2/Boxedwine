+/* Failure diagnostics must remain available when TRACE and FIXME are disabled. */
+static void shader_glsl_dump_failure_log(const struct wined3d_gl_info *gl_info, GLuint id, BOOL program)
+{
+    const char *ptr, *end, *line;
+    GLint length = 0;
+    GLsizei written = 0;
+    char *log;
+
+    if (program)
+        GL_EXTCALL(glGetProgramiv(id, GL_INFO_LOG_LENGTH, &length));
+    else
+        GL_EXTCALL(glGetShaderiv(id, GL_INFO_LOG_LENGTH, &length));
+    if (length <= 1)
+        return;
+    if (!(log = malloc(length)))
+    {
+        ERR("Unable to allocate %d bytes for the GLSL failure log.\n", length);
+        return;
+    }
+    if (program)
+        GL_EXTCALL(glGetProgramInfoLog(id, length, &written, log));
+    else
+        GL_EXTCALL(glGetShaderInfoLog(id, length, &written, log));
+    ptr = log;
+    end = ptr + min(max(written, 0), length - 1);
+    while ((line = wined3d_get_line(&ptr, end)))
+        ERR("GLSL %s %u log: %.*s%s", program ? "program" : "shader", id, (int)(ptr - line), line,
+                ptr > line && ptr[-1] == '\n' ? "" : "\n");
+    free(log);
+}
