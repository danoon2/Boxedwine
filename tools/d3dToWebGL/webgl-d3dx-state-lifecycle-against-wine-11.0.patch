diff --git a/dlls/d3dx9_36/effect.c b/dlls/d3dx9_36/effect.c
--- a/dlls/d3dx9_36/effect.c
+++ b/dlls/d3dx9_36/effect.c
@@ -4175,6 +4175,17 @@
 
     TRACE("iface %p.\n", iface);
 
+    /* Cached state blocks can retain default-pool resources. Begin recreates
+     * them lazily and captures the device state after reset. */
+    for (i = 0; i < effect->technique_count; ++i)
+    {
+        if (effect->techniques[i].saved_state)
+        {
+            IDirect3DStateBlock9_Release(effect->techniques[i].saved_state);
+            effect->techniques[i].saved_state = NULL;
+        }
+    }
+
     for (i = 0; i < effect->params.count; ++i)
         walk_parameter_tree(&effect->params.parameters[i].param, param_on_lost_device, NULL);
 
