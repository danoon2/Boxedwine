+HRESULT d3dx9_animation_controller_register_matrix_animation(ID3DXAnimationController *controller,
+        const char *set_name, const char *animation_name, UINT key_count, const struct d3dx_matrix_key *keys)
+{
+    struct d3dx9_animation_controller *animation;
+    struct d3dx9_matrix_animation_set *set;
+    struct d3dx9_matrix_animation *matrix_animation;
+    const char *effective_set_name = set_name ? set_name : "";
+    unsigned int i;
+
+    TRACE("controller %p, set_name %s, animation_name %s, key_count %u, keys %p.\n",
+            controller, debugstr_a(set_name), debugstr_a(animation_name), key_count, keys);
+
+    if (!controller || !animation_name || !key_count || !keys)
+        return D3DERR_INVALIDCALL;
+
+    animation = impl_from_ID3DXAnimationController(controller);
+    if (!(set = d3dx9_animation_controller_find_set(animation, effective_set_name)))
+    {
+        if (animation->set_count >= animation->max_sets)
+            return D3DERR_INVALIDCALL;
+
+        set = &animation->sets[animation->set_count++];
+        if (!(set->name = strdup(effective_set_name)))
+            return E_OUTOFMEMORY;
+        set->ticks_per_second = 4800.0;
+
+        if (!animation->tracks[0].set)
+        {
+            animation->tracks[0].set = set;
+            animation->tracks[0].enable = TRUE;
+        }
+    }
+
+    matrix_animation = realloc(set->animations, (set->animation_count + 1) * sizeof(*set->animations));
+    if (!matrix_animation)
+        return E_OUTOFMEMORY;
+    set->animations = matrix_animation;
+    matrix_animation = &set->animations[set->animation_count];
+    memset(matrix_animation, 0, sizeof(*matrix_animation));
+
+    if (!(matrix_animation->name = strdup(animation_name)))
+        return E_OUTOFMEMORY;
+    if (!(matrix_animation->keys = malloc(key_count * sizeof(*matrix_animation->keys))))
+    {
+        free(matrix_animation->name);
+        matrix_animation->name = NULL;
+        return E_OUTOFMEMORY;
+    }
+
+    memcpy(matrix_animation->keys, keys, key_count * sizeof(*matrix_animation->keys));
+    matrix_animation->key_count = key_count;
+    for (i = 0; i < key_count; ++i)
+        set->period_ticks = max(set->period_ticks, keys[i].time);
+    ++set->animation_count;
+
+    return D3D_OK;
+}
