+static BOOL d3dx_mesh_get_position_offset(ID3DXBaseMesh *mesh, UINT *position_offset)
+{
+    D3DVERTEXELEMENT9 declaration[MAX_FVF_DECL_SIZE];
+    DWORD fvf = mesh->lpVtbl->GetFVF(mesh);
+    unsigned int i;
+
+    if (fvf)
+    {
+        *position_offset = 0;
+        return TRUE;
+    }
+
+    if (FAILED(mesh->lpVtbl->GetDeclaration(mesh, declaration)))
+        return FALSE;
+
+    for (i = 0; declaration[i].Stream != 0xff; ++i)
+    {
+        if (!declaration[i].Stream && declaration[i].Usage == D3DDECLUSAGE_POSITION
+                && declaration[i].UsageIndex == 0)
+        {
+            *position_offset = declaration[i].Offset;
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
