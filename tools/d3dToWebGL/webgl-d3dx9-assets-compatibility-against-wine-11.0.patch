+static void d3dx9_matrix_key_lerp(const struct d3dx_matrix_key *a,
+        const struct d3dx_matrix_key *b, float t, D3DXMATRIX *out)
+{
+    const float *ma = (const float *)a->matrix.m;
+    const float *mb = (const float *)b->matrix.m;
+    float *mo = (float *)out->m;
+    D3DXVECTOR3 scale_a, scale_b, scale, translation_a, translation_b, translation;
+    D3DXQUATERNION rotation_a, rotation_b, rotation;
+    unsigned int i;
+
+    if (SUCCEEDED(D3DXMatrixDecompose(&scale_a, &rotation_a, &translation_a, &a->matrix))
+            && SUCCEEDED(D3DXMatrixDecompose(&scale_b, &rotation_b, &translation_b, &b->matrix)))
+    {
+        scale.x = scale_a.x + (scale_b.x - scale_a.x) * t;
+        scale.y = scale_a.y + (scale_b.y - scale_a.y) * t;
+        scale.z = scale_a.z + (scale_b.z - scale_a.z) * t;
+        translation.x = translation_a.x + (translation_b.x - translation_a.x) * t;
+        translation.y = translation_a.y + (translation_b.y - translation_a.y) * t;
+        translation.z = translation_a.z + (translation_b.z - translation_a.z) * t;
+        D3DXQuaternionSlerp(&rotation, &rotation_a, &rotation_b, t);
+        D3DXMatrixTransformation(out, NULL, NULL, &scale, NULL, &rotation, &translation);
+        return;
+    }
+
+    for (i = 0; i < 16; ++i)
+        mo[i] = ma[i] + (mb[i] - ma[i]) * t;
+}
+
+static void d3dx9_matrix_animation_sample(const struct d3dx9_matrix_animation *animation,
+        double position_ticks, D3DXMATRIX *matrix)
+{
+    const struct d3dx_matrix_key *keys = animation->keys;
+    unsigned int lo, hi;
+    float t;
+
+    if (!animation->key_count)
+    {
+        D3DXMatrixIdentity(matrix);
+        return;
+    }
+
+    if (animation->key_count == 1 || position_ticks <= keys[0].time)
+    {
+        *matrix = keys[0].matrix;
+        return;
+    }
+
+    for (hi = 1; hi < animation->key_count; ++hi)
+    {
+        if (position_ticks <= keys[hi].time)
+            break;
+    }
+
+    if (hi == animation->key_count)
+    {
+        *matrix = keys[animation->key_count - 1].matrix;
+        return;
+    }
+
+    lo = hi - 1;
+    if (keys[hi].time == keys[lo].time)
+    {
+        *matrix = keys[hi].matrix;
+        return;
+    }
+
+    t = (float)((position_ticks - keys[lo].time) / (double)(keys[hi].time - keys[lo].time));
+    d3dx9_matrix_key_lerp(&keys[lo], &keys[hi], t, matrix);
+}
+
+static void d3dx9_animation_controller_apply_set(struct d3dx9_animation_controller *animation,
+        const struct d3dx9_matrix_animation_set *set, double position)
+{
+    double position_ticks;
+    unsigned int i;
+
+    if (!set || !set->animation_count || !set->ticks_per_second)
+        return;
+
+    position_ticks = position * set->ticks_per_second;
+    if (set->period_ticks)
+        position_ticks = fmod(position_ticks, set->period_ticks);
+
+    for (i = 0; i < set->animation_count; ++i)
+    {
+        const struct d3dx9_matrix_animation *matrix_animation = &set->animations[i];
+        struct d3dx9_animation_output *output;
+        D3DXMATRIX matrix;
+
+        if (!(output = d3dx9_animation_controller_find_output(animation, matrix_animation->name)))
+            continue;
+
+        d3dx9_matrix_animation_sample(matrix_animation, position_ticks, &matrix);
+        if (output->matrix)
+            *output->matrix = matrix;
+        if (output->scale || output->rotation || output->translation)
+        {
+            D3DXVECTOR3 scale, translation;
+            D3DXQUATERNION rotation;
+
+            if (SUCCEEDED(D3DXMatrixDecompose(&scale, &rotation, &translation, &matrix)))
+            {
+                if (output->scale) *output->scale = scale;
+                if (output->rotation) *output->rotation = rotation;
+                if (output->translation) *output->translation = translation;
+            }
+        }
+    }
+}
