+static bool supports_float_render_target(struct d3d9_test_context *context)
+{
+    D3DDISPLAYMODE mode;
+    HRESULT hr;
+
+    hr = IDirect3D9_GetAdapterDisplayMode(context->d3d, D3DADAPTER_DEFAULT, &mode);
+    ok(hr == D3D_OK, "Failed to get adapter display mode, hr %#lx.\n", hr);
+    if (FAILED(hr))
+        return false;
+
+    hr = IDirect3D9_CheckDeviceFormat(context->d3d, D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL,
+            mode.Format, D3DUSAGE_RENDERTARGET, D3DRTYPE_SURFACE, D3DFMT_A32B32G32R32F);
+    if (hr == D3DERR_NOTAVAILABLE)
+    {
+        skip("D3DFMT_A32B32G32R32F render targets are unavailable.\n");
+        return false;
+    }
+    ok(hr == D3D_OK, "Failed to query float render-target support, hr %#lx.\n", hr);
+    return hr == D3D_OK;
+}
