+static void test_flat_fan_convention(void)
+{
+    static const struct flat_fan_vertex {float x,y,z,rhw; DWORD diffuse;} vertices[] =
+    {
+        {0,0,0.5f,1,0xffffffff}, {0,0,0.5f,1,0xffffffff},
+        {320,400,0.5f,1,0xffff0000},
+        {80,80,0.5f,1,0xff00ff00}, {240,80,0.5f,1,0xff0000ff},
+        {400,80,0.5f,1,0xffffff00}, {560,80,0.5f,1,0xffff00ff},
+    };
+    static const WORD indices16[]={0,0,1,2,3,4};
+    static const DWORD indices32[]={0,0,1,2,3,4};
+    static const struct {unsigned int x,y,color;} samples[] =
+    {
+        {200,160,0x00ff00}, {320,160,0x0000ff}, {440,160,0xffff00}, {10,10,0},
+    };
+    static const DWORD culls[]={D3DCULL_NONE,D3DCULL_CCW,D3DCULL_CW};
+    struct d3d9_test_context context;
+    IDirect3DVertexBuffer9 *vb=NULL;
+    IDirect3DIndexBuffer9 *ib16=NULL,*ib32=NULL;
+    IDirect3DDevice9 *device;
+    unsigned int route,cull,sample,color,expected;
+    HRESULT hr,draw_hr,end_hr;
+    void *data;
+
+    if (!init_test_context(&context)) return;
+    device=context.device;
+#define FAN_HR(call) do {hr=(call);ok(SUCCEEDED(hr),"%s failed, hr %#lx.\n",#call,hr);if(FAILED(hr))goto done;} while(0)
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_LIGHTING,FALSE));
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_ZENABLE,FALSE));
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_ALPHABLENDENABLE,FALSE));
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_ALPHATESTENABLE,FALSE));
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_FOGENABLE,FALSE));
+    FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_SHADEMODE,D3DSHADE_FLAT));
+    FAN_HR(IDirect3DDevice9_SetTexture(device,0,NULL));
+    FAN_HR(IDirect3DDevice9_SetTextureStageState(device,0,D3DTSS_COLOROP,D3DTOP_SELECTARG1));
+    FAN_HR(IDirect3DDevice9_SetTextureStageState(device,0,D3DTSS_COLORARG1,D3DTA_DIFFUSE));
+    FAN_HR(IDirect3DDevice9_SetTextureStageState(device,0,D3DTSS_ALPHAOP,D3DTOP_SELECTARG1));
+    FAN_HR(IDirect3DDevice9_SetTextureStageState(device,0,D3DTSS_ALPHAARG1,D3DTA_DIFFUSE));
+    FAN_HR(IDirect3DDevice9_SetTextureStageState(device,1,D3DTSS_COLOROP,D3DTOP_DISABLE));
+    FAN_HR(IDirect3DDevice9_SetFVF(device,D3DFVF_XYZRHW|D3DFVF_DIFFUSE));
+    FAN_HR(IDirect3DDevice9_CreateVertexBuffer(device,sizeof(vertices),0,0,D3DPOOL_MANAGED,&vb,NULL));
+    FAN_HR(IDirect3DVertexBuffer9_Lock(vb,0,sizeof(vertices),&data,0));
+    memcpy(data,vertices,sizeof(vertices));
+    FAN_HR(IDirect3DVertexBuffer9_Unlock(vb));
+    FAN_HR(IDirect3DDevice9_CreateIndexBuffer(device,sizeof(indices16),0,D3DFMT_INDEX16,D3DPOOL_MANAGED,&ib16,NULL));
+    FAN_HR(IDirect3DIndexBuffer9_Lock(ib16,0,sizeof(indices16),&data,0));
+    memcpy(data,indices16,sizeof(indices16));
+    FAN_HR(IDirect3DIndexBuffer9_Unlock(ib16));
+    FAN_HR(IDirect3DDevice9_CreateIndexBuffer(device,sizeof(indices32),0,D3DFMT_INDEX32,D3DPOOL_MANAGED,&ib32,NULL));
+    FAN_HR(IDirect3DIndexBuffer9_Lock(ib32,0,sizeof(indices32),&data,0));
+    memcpy(data,indices32,sizeof(indices32));
+    FAN_HR(IDirect3DIndexBuffer9_Unlock(ib32));
+    for(route=0;route<6;++route)
+    for(cull=0;cull<ARRAY_SIZE(culls);++cull)
+    {
+        FAN_HR(IDirect3DDevice9_SetStreamSource(device,0,vb,0,sizeof(vertices[0])));
+        FAN_HR(IDirect3DDevice9_SetIndices(device,route==5 ? ib32 : ib16));
+        FAN_HR(IDirect3DDevice9_SetRenderState(device,D3DRS_CULLMODE,culls[cull]));
+        FAN_HR(IDirect3DDevice9_Clear(device,0,NULL,D3DCLEAR_TARGET,0xff000000,1,0));
+        FAN_HR(IDirect3DDevice9_BeginScene(device));
+        switch(route)
+        {
+            case 0:
+                draw_hr=IDirect3DDevice9_DrawPrimitiveUP(device,D3DPT_TRIANGLEFAN,3,vertices+2,sizeof(vertices[0]));
+                break;
+            case 1:
+                draw_hr=IDirect3DDevice9_DrawIndexedPrimitiveUP(device,D3DPT_TRIANGLEFAN,0,5,3,indices16+1,D3DFMT_INDEX16,vertices+2,sizeof(vertices[0]));
+                break;
+            case 2:
+                draw_hr=IDirect3DDevice9_DrawIndexedPrimitiveUP(device,D3DPT_TRIANGLEFAN,0,5,3,indices32+1,D3DFMT_INDEX32,vertices+2,sizeof(vertices[0]));
+                break;
+            case 3:
+                draw_hr=IDirect3DDevice9_DrawPrimitive(device,D3DPT_TRIANGLEFAN,2,3);
+                break;
+            default:
+                draw_hr=IDirect3DDevice9_DrawIndexedPrimitive(device,D3DPT_TRIANGLEFAN,2,0,5,1,3);
+                break;
+        }
+        ok(SUCCEEDED(draw_hr),"Fan route %u cull %#lx failed, hr %#lx.\n",route,culls[cull],draw_hr);
+        end_hr=IDirect3DDevice9_EndScene(device);
+        ok(SUCCEEDED(end_hr),"EndScene failed, hr %#lx.\n",end_hr);
+        if(FAILED(draw_hr)||FAILED(end_hr))goto done;
+        for(sample=0;sample<ARRAY_SIZE(samples);++sample)
+        {
+            expected=culls[cull]==D3DCULL_CW ? 0 : samples[sample].color;
+            color=getPixelColor(device,samples[sample].x,samples[sample].y);
+            trace("FLAT_FAN_PIXEL route=%u cull=%lu sample=%u x=%u y=%u color=%08x expected=%08x\n",
+                route,culls[cull],sample,samples[sample].x,samples[sample].y,color,expected);
+            ok(color==expected,"Fan route %u cull %#lx sample %u: got %#x, expected %#x.\n",route,culls[cull],sample,color,expected);
+        }
+    }
+done:
+    IDirect3DDevice9_SetStreamSource(device,0,NULL,0,0);
+    IDirect3DDevice9_SetIndices(device,NULL);
+    if(vb)IDirect3DVertexBuffer9_Release(vb);
+    if(ib16)IDirect3DIndexBuffer9_Release(ib16);
+    if(ib32)IDirect3DIndexBuffer9_Release(ib32);
+    release_test_context(&context);
+#undef FAN_HR
 }
 
