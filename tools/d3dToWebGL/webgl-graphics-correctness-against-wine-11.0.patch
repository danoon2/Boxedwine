+/* Dispatch once per row. Keeping the format switch inside the nested pixel
+ * loops makes GCC 13's -O3 loop unswitching drop some low-valued format cases,
+ * leaving the upload buffer uninitialized (including A4R4G4B4). */
+static bool wined3d_texture_gl_convert_webgl_row(enum wined3d_format_id format_id,
+        const uint8_t *src_row, uint8_t *upload_row, unsigned int width)
+{
+    unsigned int x;
+    uint8_t r, g, b;
+    uint16_t v;
+    uint32_t v32;
+
+    switch (format_id)
+    {
+        case WINED3DFMT_B8G8R8_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x * 3 + 0] = src_row[x * 3 + 2];
+                upload_row[x * 3 + 1] = src_row[x * 3 + 1];
+                upload_row[x * 3 + 2] = src_row[x * 3 + 0];
+            }
+            break;
+
+        case WINED3DFMT_B8G8R8X8_UNORM:
+        case WINED3DFMT_B8G8R8X8_UNORM_SRGB:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x * 4 + 0] = src_row[x * 4 + 2];
+                upload_row[x * 4 + 1] = src_row[x * 4 + 1];
+                upload_row[x * 4 + 2] = src_row[x * 4 + 0];
+                upload_row[x * 4 + 3] = 0xff;
+            }
+            break;
+
+        case WINED3DFMT_B8G8R8A8_UNORM:
+        case WINED3DFMT_B8G8R8A8_UNORM_SRGB:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x * 4 + 0] = src_row[x * 4 + 2];
+                upload_row[x * 4 + 1] = src_row[x * 4 + 1];
+                upload_row[x * 4 + 2] = src_row[x * 4 + 0];
+                upload_row[x * 4 + 3] = src_row[x * 4 + 3];
+            }
+            break;
+
+        case WINED3DFMT_R8G8B8X8_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x * 4 + 0] = src_row[x * 4 + 0];
+                upload_row[x * 4 + 1] = src_row[x * 4 + 1];
+                upload_row[x * 4 + 2] = src_row[x * 4 + 2];
+                upload_row[x * 4 + 3] = 0xff;
+            }
+            break;
+
+        case WINED3DFMT_R8G8B8A8_UNORM:
+        case WINED3DFMT_R8G8B8A8_UNORM_SRGB:
+            for (x = 0; x < width; ++x)
+            {
+                memcpy(&upload_row[x * 4], &src_row[x * 4], 4);
+            }
+            break;
+
+        case WINED3DFMT_B5G6R5_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v = ((const uint16_t *)src_row)[x];
+                upload_row[x * 3 + 0] = (((v >> 11) & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 3 + 1] = (((v >> 5) & 0x3f) * 255 + 31) / 63;
+                upload_row[x * 3 + 2] = ((v & 0x1f) * 255 + 15) / 31;
+            }
+            break;
+
+        case WINED3DFMT_B5G5R5A1_UNORM:
