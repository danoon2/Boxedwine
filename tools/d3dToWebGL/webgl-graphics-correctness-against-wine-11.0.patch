+                upload_row[x * 4 + 1] = (((v >> 5) & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 4 + 2] = ((v & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 4 + 3] = v & 0x8000 ? 0xff : 0x00;
+            }
+            break;
+
+        case WINED3DFMT_B5G5R5X1_UNORM:
