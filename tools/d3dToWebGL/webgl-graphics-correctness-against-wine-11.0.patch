+            {
+                v = ((const uint16_t *)src_row)[x];
+                upload_row[x * 4 + 0] = (((v >> 10) & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 4 + 1] = (((v >> 5) & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 4 + 2] = ((v & 0x1f) * 255 + 15) / 31;
+                upload_row[x * 4 + 3] = 0xff;
+            }
+            break;
+
+        case WINED3DFMT_B4G4R4A4_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v = ((const uint16_t *)src_row)[x];
+                upload_row[x * 4 + 0] = ((v >> 8) & 0x0f) * 17;
+                upload_row[x * 4 + 1] = ((v >> 4) & 0x0f) * 17;
+                upload_row[x * 4 + 2] = (v & 0x0f) * 17;
+                upload_row[x * 4 + 3] = ((v >> 12) & 0x0f) * 17;
+            }
+            break;
+
+        case WINED3DFMT_B4G4R4X4_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v = ((const uint16_t *)src_row)[x];
+                upload_row[x * 4 + 0] = ((v >> 8) & 0x0f) * 17;
+                upload_row[x * 4 + 1] = ((v >> 4) & 0x0f) * 17;
+                upload_row[x * 4 + 2] = (v & 0x0f) * 17;
+                upload_row[x * 4 + 3] = 0xff;
+            }
+            break;
+
+        case WINED3DFMT_B2G3R3A8_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v = ((const uint16_t *)src_row)[x];
+                r = (v >> 5) & 0x07;
+                g = (v >> 2) & 0x07;
+                b = v & 0x03;
+                upload_row[x * 4 + 0] = (r * 255 + 3) / 7;
+                upload_row[x * 4 + 1] = (g * 255 + 3) / 7;
+                upload_row[x * 4 + 2] = (b * 255 + 1) / 3;
+                upload_row[x * 4 + 3] = v >> 8;
+            }
+            break;
+
+        case WINED3DFMT_B10G10R10A2_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v32 = ((const uint32_t *)src_row)[x];
+                upload_row[x * 4 + 0] = ((((v32 >> 20) & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 1] = ((((v32 >> 10) & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 2] = (((v32 & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 3] = ((v32 >> 30) * 255 + 1) / 3;
+            }
+            break;
+
+        case WINED3DFMT_R10G10B10A2_UNORM:
+            for (x = 0; x < width; ++x)
+            {
+                v32 = ((const uint32_t *)src_row)[x];
+                upload_row[x * 4 + 0] = (((v32 & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 1] = ((((v32 >> 10) & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 2] = ((((v32 >> 20) & 0x3ff) * 255) + 511) / 1023;
+                upload_row[x * 4 + 3] = ((v32 >> 30) * 255 + 1) / 3;
+            }
+            break;
+
+        case WINED3DFMT_A8_UNORM:
+        case WINED3DFMT_L8_UNORM:
+        case WINED3DFMT_R8_UNORM:
+        case WINED3DFMT_YV12:
+        case WINED3DFMT_NV12:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x] = src_row[x];
+            }
+            break;
+
+        case WINED3DFMT_L8A8_UNORM:
+        case WINED3DFMT_UYVY:
+        case WINED3DFMT_YUY2:
+            for (x = 0; x < width; ++x)
+            {
+                upload_row[x * 2 + 0] = src_row[x * 2 + 0];
+                upload_row[x * 2 + 1] = src_row[x * 2 + 1];
+            }
+            break;
+
+        default:
+            return false;
+    }
+    return true;
+}
