+}
+
+static void stateblock_push_projection_constants(struct wined3d_stateblock *stateblock,
+        struct wined3d_device_context *context, const struct wined3d_matrix *matrix)
+{
+    /* DirectDraw surface synchronization can invalidate the RHW projection
+     * after every draw, even when neither the viewport nor depth mode changed. */
+    if (wined3d_settings.webgl && stateblock->projection_constants_valid
+            && !memcmp(&stateblock->projection_constants, matrix, sizeof(*matrix)))
+        return;
+
+    wined3d_device_context_push_constants(context, WINED3D_PUSH_CONSTANTS_VS_FFP, WINED3D_SHADER_CONST_FFP_PROJ,
+            offsetof(struct wined3d_ffp_vs_constants, projection_matrix), sizeof(*matrix), matrix);
+
+    if (wined3d_settings.webgl && context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP])
+    {
+        memcpy(&stateblock->projection_constants, matrix, sizeof(*matrix));
+        stateblock->projection_constants_valid = true;
+    }
 }
 
