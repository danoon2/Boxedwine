+#define GLSL_FFP_VS_CACHE_LIGHT(i) (1u << (i))
+#define GLSL_FFP_VS_CACHE_TEXMATRIX(i) (1u << (WINED3D_MAX_ACTIVE_LIGHTS + (i)))
+#define GLSL_FFP_VS_CACHE_PROJECTION (1u << (WINED3D_MAX_ACTIVE_LIGHTS + WINED3D_MAX_FFP_TEXTURES))
+#define GLSL_FFP_VS_CACHE_MATERIAL (GLSL_FFP_VS_CACHE_PROJECTION << 1)
+#define GLSL_FFP_VS_CACHE_LIGHT_AMBIENT (GLSL_FFP_VS_CACHE_PROJECTION << 2)
+
+/* The WebGL profile reloads every FFP vertex uniform group whenever the
+ * context marks it dirty, and the context's dirty mask is not per program:
+ * a program usually receives values it already holds. Uniform values belong
+ * to the linked program and survive program switches, so compare against
+ * what this program was last given. Returns TRUE when the upload can be
+ * skipped; otherwise records the value and returns FALSE. */
+static BOOL shader_glsl_ffp_vs_uniform_cached(struct glsl_shader_prog_link *prog,
+        uint32_t bit, void *cache, const void *value, size_t size)
+{
+    if (!wined3d_settings.webgl)
+        return FALSE;
+    if ((prog->ffp_vs_cache_valid & bit) && !memcmp(cache, value, size))
+        return TRUE;
+    memcpy(cache, value, size);
+    prog->ffp_vs_cache_valid |= bit;
+    return FALSE;
+}
