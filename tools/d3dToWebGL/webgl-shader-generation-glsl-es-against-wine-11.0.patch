+        hash = shader_glsl_hash_u32(hash, element->register_idx);
+        hash = shader_glsl_hash_u32(hash, element->semantic_idx);
+        hash = shader_glsl_hash_u32(hash, element->sysval_semantic);
+        hash = shader_glsl_hash_u32(hash, element->component_type);
