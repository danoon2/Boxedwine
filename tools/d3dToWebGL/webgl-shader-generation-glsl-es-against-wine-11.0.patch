+static uint32_t shader_glsl_pixel_input_key(const struct wined3d_shader *shader)
+{
+    const struct wined3d_shader_signature *signature = &shader->input_signature;
+    uint32_t hash = 2166136261u;
+    unsigned int i, j;
+
+    hash = shader_glsl_hash_u32(hash, shader->reg_maps.input_registers);
+    hash = shader_glsl_hash_u32(hash, shader->u.ps.input_reg_used);
+    hash = shader_glsl_hash_u32(hash, shader->u.ps.declared_in_count);
+
+    for (i = 0; i < MAX_REG_INPUT; ++i)
+        hash = shader_glsl_hash_u32(hash, shader->u.ps.input_reg_map[i]);
