+/* Developer-only Glide 2 regression. Declares only the exercised public ABI;
+ * no vendor SDK headers or game assets are required. See README.md. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+typedef struct {
+    int size;
+    void *pixels;
+    unsigned stride;
+    int mode, origin;
+} LfbInfo;
+typedef struct {
+    float x, y, z, r, g, b, ooz, a, oow;
+    struct {
+        float sow, tow, oow;
+    } tmu[3];
+} Vertex;
+typedef void(WINAPI *VoidFn)(void);
+typedef void(WINAPI *StateFn)(unsigned);
+typedef void(WINAPI *ClearFn)(unsigned, unsigned char, unsigned short);
+typedef unsigned(WINAPI *OpenFn)(unsigned, unsigned, unsigned, unsigned, unsigned, int, int);
+typedef void(WINAPI *ClipFn)(unsigned, unsigned, unsigned, unsigned);
+typedef void(WINAPI *CombineFn)(unsigned, unsigned, unsigned, unsigned, unsigned);
+typedef void(WINAPI *TriangleFn)(const Vertex *, const Vertex *, const Vertex *);
+typedef unsigned(WINAPI *LockFn)(unsigned, unsigned, unsigned, unsigned, unsigned, LfbInfo *);
+typedef unsigned(WINAPI *UnlockFn)(unsigned, unsigned);
+static FARPROC sym(HMODULE dll, const char *name, unsigned bytes) {
+    FARPROC p = GetProcAddress(dll, name);
+    if (!p) {
+        char decorated[128];
+        sprintf(decorated, "_%s@%u", name, bytes);
+        p = GetProcAddress(dll, decorated);
+    }
+    if (!p) {
+        printf("MISSING %s\n", name);
+        exit(2);
+    }
+    return p;
+}
+typedef struct {
+    float x, y, z, rhw;
+    DWORD color;
+} V;
+static const float geometry[3][3][3] = {{{640.5625f, 404.5f, 1.6224592924f},
+                                         {525.6875f, 325.875f, 1.1750488281f},
+                                         {525.6875f, 387.4375f, 1.1750488281f}},
+                                        {{589.6875f, 353, 1.6423004866f},
+                                         {555.0625f, 353, 1.6423004866f},
+                                         {600.5f, 391.75f, 1.6769274473f}},
+                                        {{588.625f, 353.75f, 1.6442782879f},
+                                         {556.375f, 353.75f, 1.6442782879f},
+                                         {594.125f, 391.4375f, 1.6779578924f}}};
+static int inside(float x, float y, V *v) {
+    float d = (v[1].y - v[2].y) * (v[0].x - v[2].x) + (v[2].x - v[1].x) * (v[0].y - v[2].y);
+    float a = ((v[1].y - v[2].y) * (x - v[2].x) + (v[2].x - v[1].x) * (y - v[2].y)) / d;
+    float b = ((v[2].y - v[0].y) * (x - v[2].x) + (v[0].x - v[2].x) * (y - v[2].y)) / d;
+    return a > .05f && b > .05f && a + b < .95f;
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    HMODULE dll = LoadLibraryA("glide2x.dll");
+    if (!dll) {
+        puts("LOAD_FAIL");
+        return 2;
+    }
+    ((VoidFn)sym(dll, "grGlideInit", 0))();
+    StateFn config = (StateFn)GetProcAddress(dll, "setConfig");
+    if (config)
+        config(1);
+    WNDCLASSA wc = {0};
+    wc.lpfnWndProc = DefWindowProcA;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "GlideNearDepthProbe";
+    RegisterClassA(&wc);
+    HWND wnd = CreateWindowA(wc.lpszClassName, "Glide near depth regression", WS_OVERLAPPEDWINDOW,
+                             20, 20, 660, 520, NULL, NULL, wc.hInstance, NULL);
+    if (!((OpenFn)sym(dll, "grSstWinOpen", 28))((unsigned)(uintptr_t)wnd, 7, 0, 1, 0, 2, 1)) {
+        puts("OPEN_FAIL");
+        return 2;
+    }
+    TriangleFn tri = (TriangleFn)sym(dll, "grDrawTriangle", 12);
+    StateFn mode = (StateFn)sym(dll, "grDepthBufferMode", 4),
+            mask = (StateFn)sym(dll, "grDepthMask", 4),
+            func = (StateFn)sym(dll, "grDepthBufferFunction", 4),
+            bias = (StateFn)sym(dll, "grDepthBiasLevel", 4),
+            color = (StateFn)sym(dll, "grConstantColorValue", 4);
+    ClearFn clear = (ClearFn)sym(dll, "grBufferClear", 12);
+    LockFn lock = (LockFn)sym(dll, "grLfbLock", 24);
+    UnlockFn unlock = (UnlockFn)sym(dll, "grLfbUnlock", 8);
+    typedef struct {
+        int smallLod, largeLod, aspect, format;
+        void *data;
+    } TexInfo;
+    typedef void(WINAPI * TextureFn)(unsigned, unsigned, unsigned, TexInfo *);
+    typedef void(WINAPI * TexCombineFn)(unsigned, unsigned, unsigned, unsigned, unsigned, unsigned,
+                                        unsigned);
+    unsigned short texels[4] = {0xffff, 0xffff, 0xffff, 0xffff};
+    TexInfo tex = {7, 7, 3, 10, texels};
+    ((TextureFn)sym(dll, "grTexDownloadMipMap", 16))(0, 0, 3, &tex);
+    ((TextureFn)sym(dll, "grTexSource", 16))(0, 0, 3, &tex);
+    ((TexCombineFn)sym(dll, "grTexCombine", 28))(0, 1, 0, 1, 0, 0, 0);
+    ((CombineFn)sym(dll, "grColorCombine", 20))(3, 1, 1, 1, 0);
+    mode(2);
+    mask(1);
+    bias((unsigned)-1024);
+    unsigned bad = 0, samples = 0;
+    for (int textured = 0; textured < 2; textured++)
+        for (int cmp = 0; cmp < 2; cmp++)
+            for (int frame = 0; frame < 16; frame++) {
+                unsigned frameBad = bad;
+                ((CombineFn)sym(dll, "grColorCombine", 20))(textured ? 3 : 1, textured ? 1 : 0, 1,
+                                                            textured ? 1 : 2, 0);
+                clear(0, 255, 65535);
+                func(cmp ? 1 : 3);
+                V final[3], behind[3];
+                for (int t = 0; t < 3; t++) {
+                    Vertex v[3] = {{0}};
+                    for (int i = 0; i < 3; i++) {
+                        v[i].x = geometry[t][i][0] - 400 + frame * .0625f + .5f;
+                        v[i].y = geometry[t][i][1] - 250 + frame * .125f + .5f;
+                        v[i].oow = geometry[t][i][2];
+                        v[i].a = 255;
+                        // Exercise shader cache transitions and flush queued ordinary geometry.
+                        if (t == 0 && (frame & 1))
+                            v[i].oow *= .1f;
+                        v[i].tmu[0].sow = v[i].tmu[0].tow = .5f * v[i].oow;
+                        v[i].tmu[0].oow = v[i].oow;
+                        final[i].x = v[i].x - .5f;
+                        final[i].y = v[i].y - .5f;
+                    }
+                    color(t == 2 ? 0xff00ff00 : 0xff0000ff);
+                    tri(v, v + 1, v + 2);
+                    if (t == 1)
+                        memcpy(behind, final, sizeof(behind));
+                }
+                LfbInfo info = {sizeof(info)};
+                if (!lock(0, 1, 0, 0, 0, &info)) {
+                    puts("READ_FAIL");
+                    return 2;
+                }
+                unsigned short expected = cmp ? 0xf800 : 0x07e0;
+                for (int y = 80; y < 160; y++)
+                    for (int x = 120; x < 220; x++)
+                        if (inside((float)x, (float)y, final) &&
+                            inside((float)x, (float)y, behind)) {
+                            unsigned short p =
+                                *(unsigned short *)((char *)info.pixels + y * info.stride + x * 2);
+                            samples++;
+                            if (p != expected) {
+                                if (bad < 8)
+                                    printf(
+                                        "BAD cmp=%d frame=%d x=%d y=%d expected=%04x actual=%04x\n",
+                                        cmp, frame, x, y, expected, p);
+                                bad++;
+                            }
+                        }
+                unlock(0, 1);
+                if (bad != frameBad)
+                    printf("FRAME textured=%d cmp=%d frame=%d mismatches=%u\n", textured, cmp,
+                           frame, bad - frameBad);
+            }
+    printf("W_NEAR_DEPTH_%s frames=64 samples=%u mismatches=%u\n", bad ? "FAIL" : "PASS", samples,
+           bad);
+    ((VoidFn)sym(dll, "grSstWinClose", 0))();
+    ((VoidFn)sym(dll, "grGlideShutdown", 0))();
+    DestroyWindow(wnd);
+    return bad ? 1 : 0;
+}
