+/* whether a CD-ROM drive has a disc, and whether it changed since the last call */
+static NTSTATUS check_cdrom_media( void *args )
+{
+#if defined(linux) && defined(HAVE_LINUX_CDROM_H)
+    const struct check_cdrom_media_params *params = args;
+    int fd, status;
+
+    if ((fd = open( params->device, O_RDONLY | O_NONBLOCK )) == -1) return STATUS_NO_SUCH_FILE;
+    status = ioctl( fd, CDROM_DRIVE_STATUS, CDSL_CURRENT );
+    *params->changed = ioctl( fd, CDROM_MEDIA_CHANGED, CDSL_CURRENT ) > 0;
+    close( fd );
+    if (status == -1 || status == CDS_NO_INFO) return STATUS_NOT_SUPPORTED;
+    *params->present = (status == CDS_DISC_OK);
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
