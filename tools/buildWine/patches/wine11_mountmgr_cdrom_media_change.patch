+/* CD-ROM drives that are not handled by udisks or DiskArbitration, whose disc changes
+ * have to be found by asking the drive */
+static BOOL is_polled_cdrom( struct volume *volume )
+{
+    return volume && !volume->udi && volume->device->unix_device &&
+           (volume->device->type == DEVICE_CDROM || volume->device->type == DEVICE_DVD);
+}
+
+/* re-read a CD-ROM drive's label, serial and file system after its disc was ejected
+ * or swapped; called with device_section held */
+static void refresh_cdrom_volume( struct volume *volume )
+{
+    BOOL present = FALSE, changed = FALSE;
+    struct check_cdrom_media_params params = { volume->device->unix_device, &present, &changed };
+
+    if (!is_polled_cdrom( volume )) return;
+    if (MOUNTMGR_CALL( check_cdrom_media, &params )) return;
+    if (!changed && present == !volume->no_media) return;
+
+    volume->label[0] = 0;
+    volume->serial = 0;
+    volume->fs_type = FS_UNKNOWN;
+    volume->no_media = !present;
+    if (present && !get_volume_device_info( volume ))
+        volume->fs_type = (volume->device->type == DEVICE_DVD) ? FS_UDF : FS_ISO9660;
+    if (!volume->no_media && !volume->serial)
+        memcpy( &volume->serial, &volume->guid.Data4[4], sizeof(DWORD) );
+    volume->media_count++;
+    TRACE( "%s: %s, label %s, serial %08lx\n", debugstr_a(volume->device->unix_device),
+           volume->no_media ? "no media" : "media changed", debugstr_w(volume->label), volume->serial );
+}
+
+/* tell applications about discs ejected from or inserted into polled CD-ROM drives */
+static DWORD CALLBACK cdrom_media_thread( void *arg )
+{
+    struct { int drive; int code; } notify[2 * MAX_DOS_DRIVES];
+    struct dos_drive *drive;
+    unsigned int i, count;
+
+    for (;;)
+    {
+        Sleep( 1000 );
+        count = 0;
+        EnterCriticalSection( &device_section );
+        LIST_FOR_EACH_ENTRY( drive, &drives_list, struct dos_drive, entry )
+        {
+            if (!is_polled_cdrom( drive->volume )) continue;
+            refresh_cdrom_volume( drive->volume );
+            if (drive->media_count == drive->volume->media_count) continue;
+            drive->media_count = drive->volume->media_count;
+            if (drive->media_present)
+            {
+                notify[count].drive = drive->drive;
+                notify[count++].code = DBT_DEVICEREMOVECOMPLETE;
+            }
+            drive->media_present = !drive->volume->no_media;
+            if (drive->media_present)
+            {
+                notify[count].drive = drive->drive;
+                notify[count++].code = DBT_DEVICEARRIVAL;
+            }
+        }
+        LeaveCriticalSection( &device_section );
+        /* outside the lock: a window procedure may query the volume */
+        for (i = 0; i < count; i++) send_notify( notify[i].drive, notify[i].code );
+    }
+    return 0;
+}
+
+static void start_cdrom_media_thread(void)
+{
+    struct dos_drive *drive;
+    BOOL found = FALSE;
+    HANDLE thread;
+
+    EnterCriticalSection( &device_section );
+    LIST_FOR_EACH_ENTRY( drive, &drives_list, struct dos_drive, entry )
+    {
+        BOOL present, changed;
+        struct check_cdrom_media_params params = { NULL, &present, &changed };
+
+        if (!is_polled_cdrom( drive->volume )) continue;
+        /* the disc was just read, so drop any change the drive still reports from before */
+        params.device = drive->volume->device->unix_device;
+        MOUNTMGR_CALL( check_cdrom_media, &params );
+        drive->media_count = drive->volume->media_count;
+        drive->media_present = !drive->volume->no_media;
+        found = TRUE;
+    }
+    LeaveCriticalSection( &device_section );
+    if (found && (thread = CreateThread( NULL, 0, cdrom_media_thread, NULL, 0, NULL ))) CloseHandle( thread );
+}
