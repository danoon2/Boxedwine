@@ -1844,6 +1953,17 @@ static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
     case IOCTL_CDROM_READ_TOC:
         status = STATUS_INVALID_DEVICE_REQUEST;
         break;
+    case IOCTL_STORAGE_CHECK_VERIFY:
+    case IOCTL_STORAGE_CHECK_VERIFY2:
+        if (!is_polled_cdrom( dev->volume ))
+        {
+            FIXME( "Unsupported check verify\n" );
+            status = STATUS_NOT_SUPPORTED;
+            break;
+        }
+        refresh_cdrom_volume( dev->volume );
+        status = dev->volume->no_media ? STATUS_NO_MEDIA_IN_DEVICE : STATUS_SUCCESS;
+        break;
     case IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS:
     {
         struct size_info size_info = { 0, 0, 0, 0, 0 };
@@ -1905,6 +2025,7 @@ NTSTATUS WINAPI harddisk_driver_entry( DRIVER_OBJECT *driver, UNICODE_STRING *pa
     create_disk_device( DEVICE_HARDDISK, &device, NULL );
 
     create_drive_devices();
+    start_cdrom_media_thread();
 
     return STATUS_SUCCESS;
 }
