+/* OpenGL cannot capture a swizzle of a varying. Keep the normal rasterizer
+ * interface and expose each partial stream-output element as a separate varying.
+ * D3D10 always selects rasterizer stream zero, even for SO-only draws. */
+static void shader_glsl_generate_partial_stream_output(struct wined3d_string_buffer *buffer,
+        const struct wined3d_shader *shader, BOOL declarations)
+{
+    const struct wined3d_stream_output_desc *so_desc;
+    unsigned int i, register_idx, component_idx;
+
+    if (shader->reg_maps.shader_version.type != WINED3D_SHADER_TYPE_GEOMETRY
+            || !(so_desc = shader->u.gs.so_desc))
+        return;
+
+    for (i = 0; i < so_desc->element_count; ++i)
+    {
+        const struct wined3d_stream_output_element *e = &so_desc->elements[i];
+        char mask[6];
+
+        if (e->stream_idx || !e->semantic_name
+                || !shader_get_stream_output_register_info(shader, e, &register_idx, &component_idx)
+                || (!component_idx && e->component_count == 4))
+            continue;
+
+        if (declarations)
+        {
+            if (e->component_count == 1)
+                shader_addline(buffer, "out float so_output%u;\n", i);
+            else
+                shader_addline(buffer, "out vec%u so_output%u;\n", e->component_count, i);
+        }
+        else
+        {
+            shader_glsl_write_mask_to_str(wined3d_mask_from_size(e->component_count) << component_idx, mask);
+            shader_addline(buffer, "so_output%u = outputs[%u]%s;\n", i, register_idx, mask);
+        }
+    }
+}
