@@ -1263,6 +1263,165 @@ static HRESULT wined3d_so_statistics_query_create(struct wined3d_device *device,
     return WINED3D_OK;
 }
 
+static void wined3d_so_overflow_query_end(struct wined3d_so_overflow_query *query,
+        struct wined3d_context_gl *context_gl)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+
+    if (gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+        GL_EXTCALL(glEndQueryIndexed(query->target, query->stream_idx));
+    else
+        GL_EXTCALL(glEndQuery(query->target));
+    query->started = FALSE;
+    checkGLcall("end SO overflow query");
+}
+
+static BOOL wined3d_so_overflow_query_ops_poll(struct wined3d_query *query, uint32_t flags)
+{
+    struct wined3d_so_overflow_query *oq = CONTAINING_RECORD(query, struct wined3d_so_overflow_query, query);
+    const struct wined3d_gl_info *gl_info;
+    struct wined3d_context_gl *context_gl;
+    GLuint available, overflow;
+
+    if (!oq->context_gl)
+        return TRUE;
+    if (!(context_gl = wined3d_context_gl_reacquire(oq->context_gl)))
+    {
+        WARN("Cannot poll SO overflow query %p from this thread.\n", query);
+        return FALSE;
+    }
+    gl_info = context_gl->gl_info;
+
+    GL_EXTCALL(glGetQueryObjectuiv(oq->id, GL_QUERY_RESULT_AVAILABLE, &available));
+    if (available)
+    {
+        GL_EXTCALL(glGetQueryObjectuiv(oq->id, GL_QUERY_RESULT, &overflow));
+        oq->overflow = !!overflow;
+    }
+    checkGLcall("poll SO overflow query");
+    context_release(&context_gl->c);
+
+    return available;
+}
+
+static BOOL wined3d_so_overflow_query_ops_issue(struct wined3d_query *query, uint32_t flags)
+{
+    struct wined3d_so_overflow_query *oq = CONTAINING_RECORD(query, struct wined3d_so_overflow_query, query);
+    const struct wined3d_gl_info *gl_info;
+    struct wined3d_context_gl *context_gl;
+    BOOL poll = FALSE;
+
+    if (!(flags & (WINED3DISSUE_BEGIN | WINED3DISSUE_END)))
+        return FALSE;
+    if (oq->context_gl)
+    {
+        if (!(context_gl = wined3d_context_gl_reacquire(oq->context_gl)))
+        {
+            WARN("Cannot issue SO overflow query %p from this thread.\n", query);
+            return FALSE;
+        }
+    }
+    else
+    {
+        if (!(flags & WINED3DISSUE_BEGIN))
+            return FALSE;
+        context_gl = wined3d_context_gl(context_acquire(query->device, NULL, 0));
+        gl_info = context_gl->gl_info;
+        GL_EXTCALL(glGenQueries(1, &oq->id));
+        oq->context_gl = context_gl;
+        list_add_head(&context_gl->so_overflow_queries, &oq->entry);
+    }
+    gl_info = context_gl->gl_info;
+
+    if (flags & WINED3DISSUE_BEGIN)
+    {
+        if (oq->started)
+            wined3d_so_overflow_query_end(oq, context_gl);
+        oq->overflow = FALSE;
+        if (gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+            GL_EXTCALL(glBeginQueryIndexed(oq->target, oq->stream_idx, oq->id));
+        else
+            GL_EXTCALL(glBeginQuery(oq->target, oq->id));
+        oq->started = TRUE;
+        checkGLcall("begin SO overflow query");
+    }
+    if ((flags & WINED3DISSUE_END) && oq->started)
+    {
+        wined3d_so_overflow_query_end(oq, context_gl);
+        poll = TRUE;
+    }
+    context_release(&context_gl->c);
+
+    return poll;
+}
+
+static void wined3d_so_overflow_query_ops_destroy(struct wined3d_query *query)
+{
+    struct wined3d_so_overflow_query *oq = CONTAINING_RECORD(query, struct wined3d_so_overflow_query, query);
+    const struct wined3d_gl_info *gl_info;
+    struct wined3d_context_gl *context_gl;
+
+    if (oq->context_gl)
+    {
+        list_remove(&oq->entry);
+        if ((context_gl = wined3d_context_gl_reacquire(oq->context_gl)))
+        {
+            gl_info = context_gl->gl_info;
+            if (oq->started)
+                wined3d_so_overflow_query_end(oq, context_gl);
+            GL_EXTCALL(glDeleteQueries(1, &oq->id));
+            checkGLcall("delete SO overflow query");
+            context_release(&context_gl->c);
+        }
+        else
+        {
+            WARN("Leaking GL query %u until its context is destroyed.\n", oq->id);
+        }
+    }
+    free(oq);
+}
+
+static const struct wined3d_query_ops so_overflow_query_ops =
+{
+    wined3d_so_overflow_query_ops_poll,
+    wined3d_so_overflow_query_ops_issue,
+    wined3d_so_overflow_query_ops_destroy,
+};
+
+static HRESULT wined3d_so_overflow_query_create(struct wined3d_device *device,
+        enum wined3d_query_type type, void *parent, const struct wined3d_parent_ops *parent_ops,
+        struct wined3d_query **query)
+{
+    const struct wined3d_gl_info *gl_info = &wined3d_adapter_gl(device->adapter)->gl_info;
+    struct wined3d_so_overflow_query *object;
+    unsigned int stream_idx = type == WINED3D_QUERY_TYPE_SO_OVERFLOW
+            ? 0 : type - WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM0;
+
+    /* 3DMark Vantage creates this query during its Direct3D 10 capability check.
+     * Use a separate GL target so SO statistics can be collected concurrently. */
+    if (!gl_info->supported[ARB_TRANSFORM_FEEDBACK_OVERFLOW_QUERY])
+    {
+        WARN("OpenGL implementation does not support SO overflow queries.\n");
+        return WINED3DERR_NOTAVAILABLE;
+    }
+    if (stream_idx && !gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+    {
+        WARN("OpenGL implementation does not support indexed queries.\n");
+        return WINED3DERR_NOTAVAILABLE;
+    }
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    wined3d_query_init(&object->query, device, type, &object->overflow,
+            sizeof(object->overflow), &so_overflow_query_ops, parent, parent_ops);
+    object->target = type == WINED3D_QUERY_TYPE_SO_OVERFLOW
+            ? GL_TRANSFORM_FEEDBACK_OVERFLOW_ARB : GL_TRANSFORM_FEEDBACK_STREAM_OVERFLOW_ARB;
+    object->stream_idx = stream_idx;
+    *query = &object->query;
+
+    return WINED3D_OK;
+}
+
 static void wined3d_pipeline_query_ops_destroy(struct wined3d_query *query)
 {
     struct wined3d_pipeline_statistics_query *pq = wined3d_pipeline_statistics_query_from_query(query);
@@ -1334,6 +1493,13 @@ HRESULT wined3d_query_gl_create(struct wined3d_device *device, enum wined3d_quer
         case WINED3D_QUERY_TYPE_SO_STATISTICS_STREAM3:
             return wined3d_so_statistics_query_create(device, type, parent, parent_ops, query);
 
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM0:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM1:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM2:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM3:
+            return wined3d_so_overflow_query_create(device, type, parent, parent_ops, query);
+
         case WINED3D_QUERY_TYPE_PIPELINE_STATISTICS:
             return wined3d_pipeline_query_create(device, type, parent, parent_ops, query);
 
