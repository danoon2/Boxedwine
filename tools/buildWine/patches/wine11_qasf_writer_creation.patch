diff --git a/dlls/qasf/asfwriter.c b/dlls/qasf/asfwriter.c
new file mode 100644
index 00000000000..eea49ca3ec0
--- /dev/null
+++ b/dlls/qasf/asfwriter.c
@@ -0,0 +1,54 @@
+/*
+ * Minimal ASF writer filter for applications that check media availability.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ */
+
+#include "qasf_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(quartz);
+
+static struct strmbase_pin *asf_writer_get_pin(struct strmbase_filter *filter, unsigned int index)
+{
+    return NULL;
+}
+
+static void asf_writer_destroy(struct strmbase_filter *filter)
+{
+    strmbase_filter_cleanup(filter);
+    free(filter);
+}
+
+static HRESULT asf_writer_init_stream(struct strmbase_filter *filter)
+{
+    FIXME("ASF encoding is not implemented.\n");
+    return E_NOTIMPL;
+}
+
+static const struct strmbase_filter_ops asf_writer_ops =
+{
+    .filter_get_pin = asf_writer_get_pin,
+    .filter_destroy = asf_writer_destroy,
+    .filter_init_stream = asf_writer_init_stream,
+};
+
+HRESULT asf_writer_create(IUnknown *outer, IUnknown **out)
+{
+    struct strmbase_filter *filter;
+
+    if (!(filter = calloc(1, sizeof(*filter))))
+        return E_OUTOFMEMORY;
+
+    strmbase_filter_init(filter, outer, &CLSID_WMAsfWriter, &asf_writer_ops);
+    *out = &filter->IUnknown_inner;
+    TRACE("Created WM ASF writer %p.\n", filter);
+    return S_OK;
+}
