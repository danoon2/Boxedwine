+/* Unlike rasterization, legacy extents include every supplied vertex, even
+ * unreferenced vertices in indexed draws. Call with the wined3d mutex held. */
+static void d3d_device_update_extents(struct d3d_device *device, DWORD fvf,
+        const void *vertices, unsigned int stride, unsigned int vertex_count)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    const struct wined3d_viewport *vp = &state->viewport;
+    D3DCLIPSTATUS *cs = &device->clip_status;
+    DWORD position = fvf & D3DFVF_POSITION_MASK;
+    struct wined3d_matrix m;
+    unsigned int i;
+
+    if (!state->rs[WINED3D_RS_EXTENTS])
+        return;
+
+    if (position != D3DFVF_XYZ && position != D3DFVF_XYZRHW)
+    {
+        FIXME("Unhandled position format %#lx for extents.\n", position);
+        /* Retain the old conservative bounds for unsupported vertex blending. */
+        cs->minx = min(cs->minx, vp->x);
+        cs->maxx = max(cs->maxx, vp->x + vp->width);
+        cs->miny = min(cs->miny, vp->y);
+        cs->maxy = max(cs->maxy, vp->y + vp->height);
+        return;
+    }
+
+    if (position == D3DFVF_XYZ)
+    {
+        multiply_matrix(&m, &state->transforms[WINED3D_TS_VIEW], &state->transforms[WINED3D_TS_WORLD]);
+        multiply_matrix(&m, &state->transforms[WINED3D_TS_PROJECTION], &m);
+    }
+
+    for (i = 0; i < vertex_count; ++i)
+    {
+        const float *v = (const float *)((const char *)vertices + i * stride);
+        float x = v[0], y = v[1];
+
+        if (position == D3DFVF_XYZ)
+        {
+            float w = v[0] * m._14 + v[1] * m._24 + v[2] * m._34 + m._44;
+            float z = v[0] * m._13 + v[1] * m._23 + v[2] * m._33 + m._43;
+
+            if (!w || (state->rs[WINED3D_RS_CLIPPING] && (z < 0.0f || z > w)))
+                continue;
+            x = v[0] * m._11 + v[1] * m._21 + v[2] * m._31 + m._41;
+            y = v[0] * m._12 + v[1] * m._22 + v[2] * m._32 + m._42;
+            x = vp->x + (1.0f + x / w) * vp->width * 0.5f;
+            y = vp->y + (1.0f - y / w) * vp->height * 0.5f;
+        }
+        cs->minx = min(cs->minx, x);
+        cs->maxx = max(cs->maxx, x);
+        cs->miny = min(cs->miny, y);
+        cs->maxy = max(cs->maxy, y);
+    }
+
+    if (position == D3DFVF_XYZ)
+    {
+        /* Native expands the accumulated bounds once per untransformed draw,
+         * including empty depth-clipped draws, then clamps to the viewport.
+         * XYZRHW draws neither expand nor clamp the supplied screen positions. */
+        cs->minx = max((float)vp->x, cs->minx - 1.0f);
+        cs->maxx = min((float)(vp->x + vp->width), cs->maxx + 1.0f);
+        cs->miny = max((float)vp->y, cs->miny - 1.0f);
+        cs->maxy = min((float)(vp->y + vp->height), cs->maxy + 1.0f);
+    }
+}
