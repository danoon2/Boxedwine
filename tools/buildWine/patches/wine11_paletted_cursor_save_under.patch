diff --git a/dlls/win32u/palette.c b/dlls/win32u/palette.c
index 4cf03b1ae2d..c69b564b985 100644
--- a/dlls/win32u/palette.c
+++ b/dlls/win32u/palette.c
@@ -55,11 +55,42 @@ static const struct gdi_obj_funcs palette_funcs =
     PALETTE_DeleteObject      /* pDeleteObject */
 };
 
-static UINT SystemPaletteUse = SYSPAL_STATIC;  /* currently not considered */
+static UINT SystemPaletteUse = SYSPAL_STATIC;
 
 static HPALETTE hPrimaryPalette = 0; /* used for WM_PALETTECHANGED */
 static HPALETTE hLastRealizedPalette = 0; /* UnrealizeObject() needs it */
 
+/* Selected DDBs must keep observing the device palette after realization.
+ * A fixed DIB color cube loses colors when an 8-bit screen is saved/restored. */
+static RGBQUAD ddb_color_table[256];
+static pthread_once_t ddb_color_table_once = PTHREAD_ONCE_INIT;
+
+static void init_ddb_color_table(void)
+{
+    memcpy( ddb_color_table, get_default_color_table( 8 ), sizeof(ddb_color_table) );
+}
+
+const RGBQUAD *get_ddb_color_table(void)
+{
+    pthread_once( &ddb_color_table_once, init_ddb_color_table );
+    return ddb_color_table;
+}
+
+static void update_ddb_color_table( DC *dc )
+{
+    PALETTEENTRY entries[256];
+    PHYSDEV dev = GET_DC_PHYSDEV( dc, pGetSystemPaletteEntries );
+    UINT i;
+
+    if (dev->funcs->pGetSystemPaletteEntries( dev, 0, 256, entries ) != 256) return;
+    get_ddb_color_table();
+    for (i = 0; i < 256; i++)
+    {
+        RGBQUAD color = { entries[i].peBlue, entries[i].peGreen, entries[i].peRed, 0 };
+        ddb_color_table[i] = color;
+    }
+}
+
 
 /***********************************************************************
  *           PALETTE_Init
@@ -308,6 +339,7 @@ UINT WINAPI NtGdiSetSystemPaletteUse( HDC hdc, UINT use )
         case SYSPAL_NOSTATIC256:        /* WINVER >= 0x0500 */
         case SYSPAL_STATIC:
             SystemPaletteUse = use;
+            if (old != use) hLastRealizedPalette = 0;
             return old;
         default:
             return SYSPAL_ERROR;
@@ -575,6 +607,7 @@ UINT WINAPI NtUserRealizePalette( HDC hdc )
     }
     else TRACE("  skipping (hLastRealizedPalette = %p)\n", hLastRealizedPalette);
 
+    update_ddb_color_table( dc );
     release_dc_ptr( dc );
     TRACE("   realized %i colors.\n", realized );
 
