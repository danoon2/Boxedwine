diff --git a/dlls/winex11.drv/dllmain.c b/dlls/winex11.drv/dllmain.c
--- a/dlls/winex11.drv/dllmain.c
+++ b/dlls/winex11.drv/dllmain.c
@@ -22,12 +22,129 @@
 #include "windef.h"
 #include "winbase.h"
 #include "wine/unixlib.h"
+#include "winternl.h"
+#include "winuser.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(x11drv);
+
+#define WM_X11_CLIP_CURSOR (WM_USER + 1)
+
+struct clip_request
+{
+    void *args;
+    HANDLE done;
+    BOOL result;
+};
+
+static HWND input_window;
+static HINSTANCE driver_instance;
+static INIT_ONCE input_once = INIT_ONCE_STATIC_INIT;
+
+static LRESULT CALLBACK input_window_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    if (msg == WM_X11_CLIP_CURSOR)
+    {
+        struct clip_request *request = (void *)lp;
+        request->result = !WINE_UNIX_CALL( x11drv_input_clip_cursor_call, request->args );
+        SetEvent( request->done );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static DWORD WINAPI input_thread_proc( void *arg )
+{
+    WNDCLASSW cls = {0};
+    MSG msg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_x11_input" );
+    SetThreadDpiAwarenessContext( DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE );
+    cls.lpfnWndProc = input_window_proc;
+    cls.hInstance = driver_instance;
+    cls.lpszClassName = L"WineX11Input";
+    RegisterClassW( &cls );
+    input_window = CreateWindowW( cls.lpszClassName, NULL, 0, 0, 0, 0, 0,
+                                  HWND_MESSAGE, NULL, driver_instance, NULL );
+    SetEvent( arg );
+    if (!input_window) return 0;
+    while (GetMessageW( &msg, NULL, 0, 0 ) > 0)
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    return 0;
+}
+
+static BOOL WINAPI start_input_thread( INIT_ONCE *once, void *param, void **context )
+{
+    HANDLE event, thread;
+    BOOL ret = FALSE;
+
+    if (!(event = CreateEventW( NULL, FALSE, FALSE, NULL ))) return FALSE;
+    if ((thread = CreateThread( NULL, 0, input_thread_proc, event, 0, NULL )))
+    {
+        WaitForSingleObject( event, INFINITE );
+        CloseHandle( thread );
+        ret = !!input_window;
+    }
+    CloseHandle( event );
+    return ret;
+}
+
+/* The driver can be called while win32u is preparing a message-queue wait.
+ * SendMessage changes that queue's wake masks (even with SMTO_BLOCK) and can
+ * dispatch application messages. Use an event so internal clipping leaves
+ * the caller's message queue and window procedures alone. */
+static BOOL request_clip_cursor( void *args )
+{
+    struct clip_request request = { .args = args };
+    BOOL ret = FALSE;
+
+    if (GetWindowThreadProcessId( input_window, NULL ) == GetCurrentThreadId())
+        return !WINE_UNIX_CALL( x11drv_input_clip_cursor_call, args );
+    if (!(request.done = CreateEventW( NULL, FALSE, FALSE, NULL ))) return FALSE;
+    if (PostMessageW( input_window, WM_X11_CLIP_CURSOR, 0, (LPARAM)&request ))
+    {
+        WaitForSingleObject( request.done, INFINITE );
+        ret = request.result;
+    }
+    CloseHandle( request.done );
+    return ret;
+}
+
+static NTSTATUS WINAPI clip_cursor( void *args, ULONG size )
+{
+    struct clip_cursor_params *params = args;
+    BOOL ret = FALSE;
+    unsigned int attempt;
+
+    if (!params->clip && !input_window) ret = TRUE;
+    else if (InitOnceExecuteOnce( &input_once, start_input_thread, NULL, NULL ))
+    {
+        /* Starting the helper can allow a ButtonPress to take an implicit grab
+         * on the window connection. Release it after startup, and retry if a
+         * new press races the handoff to the input connection. */
+        for (attempt = 0; attempt < 4; ++attempt)
+        {
+            if (params->clip) WINE_UNIX_CALL( x11drv_prepare_clip_cursor_call, args );
+            ret = request_clip_cursor( args );
+            if (ret) break;
+        }
+    }
+    return NtCallbackReturn( &ret, sizeof(ret), 0 );
+}
+
 
 BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
 {
+    UINT64 callback = (UINT_PTR)clip_cursor;
+
     if (reason != DLL_PROCESS_ATTACH) return TRUE;
 
     DisableThreadLibraryCalls( instance );
     if (__wine_init_unix_call()) return FALSE;
-    return !WINE_UNIX_CALL( 0, NULL );
+    driver_instance = instance;
+    return !WINE_UNIX_CALL( x11drv_init_call, &callback );
 }
