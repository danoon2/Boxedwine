@@ -1436,11 +1440,91 @@ BOOL X11DRV_GetCursorPos(LPPOINT pos)
 /***********************************************************************
  *		ClipCursor (X11DRV.@)
  */
+/* The desktop can release capture while the application thread is blocked.
+ * Drop our raw-motion subscription too, but ignore an old UnmapNotify from
+ * our own unmap/map sequence when the current grab is still valid. */
+void clip_window_unmapped( Window window )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    XWindowAttributes attr;
+    Window focus;
+    int revert;
+
+    if (!data->clipping_cursor || window != data->clip_window) return;
+    XGetInputFocus( data->display, &focus, &revert );
+    if (focus == clip_focus && XGetWindowAttributes( data->display, window, &attr ) &&
+        attr.map_state == IsViewable) return;
+
+    clipping_cursor = FALSE;
+    data->clipping_cursor = FALSE;
+    x11drv_xinput2_disable( data->display, DefaultRootWindow( data->display ) );
+}
+
+NTSTATUS x11drv_prepare_clip_cursor( void *args )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+
+    /* Core button events must no longer be owned by the application thread. */
+    if (!data) return 0;
+    XUngrabPointer( data->display, CurrentTime );
+    XSync( data->display, False );
+    X11DRV_ProcessEvents( QS_INPUT );
+    return 0;
+}
+
+NTSTATUS x11drv_input_clip_cursor( void *args )
+{
+    struct clip_cursor_params *params = args;
+    struct x11drv_thread_data *data = x11drv_init_thread_data();
+    Window focus;
+    int revert;
+
+    if (params->clip)
+    {
+        XGetInputFocus( data->display, &focus, &revert );
+        if (focus != params->focus) return 0;
+    }
+    if (!params->clip) ungrab_clipping_window();
+    else
+    {
+        clip_focus = params->focus;
+        if (!grab_clipping_window( &params->rect ))
+        {
+            ungrab_clipping_window();
+            XFlush( data->display );
+            return STATUS_UNSUCCESSFUL;
+        }
+    }
+    XFlush( data->display );
+    return 0;
+}
+
 BOOL X11DRV_ClipCursor( const RECT *clip, BOOL reset )
 {
-    if (reset || !clip || !grab_clipping_window( clip )) ungrab_clipping_window();
-    XFlush( x11drv_thread_data()->display );
-    return TRUE;
+    struct clip_cursor_params params = { .dispatch.callback = clip_cursor_callback,
+                                        .clip = !!clip && !reset };
+    void *ret;
+    ULONG size;
+    Window focus;
+    int revert;
+
+    if (NtUserGetWindowThread( NtUserGetDesktopWindow(), NULL ) == GetCurrentThreadId())
+    {
+        if (reset || !clip) ungrab_clipping_window();
+        XFlush( x11drv_thread_data()->display );
+        return TRUE;
+    }
+    if (params.clip)
+    {
+        /* The window context is on the caller's X connection. Recheck the
+         * same focus on the input connection before taking the grab. */
+        if (!is_current_process_focused()) return TRUE;
+        params.rect = *clip;
+        XGetInputFocus( x11drv_thread_data()->display, &focus, &revert );
+        params.focus = focus;
+    }
+    if (KeUserDispatchCallback( &params.dispatch, sizeof(params), &ret, &size )) return FALSE;
+    return size == sizeof(BOOL) && *(BOOL *)ret;
 }
 
 /***********************************************************************
