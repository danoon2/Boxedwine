 /* Context activation is done by the caller. */
+/* Eight 16 KiB blocks fit the minimum OpenGL 3.1 uniform block size and expose
+ * all 8192 D3D9 software vertex constants, including relative addressing. */
+static bool shader_glsl_uses_swvp_constants(const struct wined3d_shader *shader, const struct wined3d_gl_info *gl_info)
+{
+    return gl_info->supported[ARB_UNIFORM_BUFFER_OBJECT]
+            && gl_info->limits.uniform_blocks[WINED3D_SHADER_TYPE_VERTEX] >= 8
+            && shader->reg_maps.shader_version.type == WINED3D_SHADER_TYPE_VERTEX
+            && shader->limits->constant_float == WINED3D_MAX_VS_CONSTS_F_SWVP;
+}
+
+static void shader_glsl_load_swvp_constants(const struct wined3d_shader *shader,
+        struct wined3d_context_gl *context_gl, struct wined3d_buffer *constant_buffer)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct glsl_context_data *data = context_gl->c.shader_backend_data;
+    const struct wined3d_shader_lconst *lconst;
+    const void *constants = constant_buffer ? wined3d_buffer_load_sysmem(constant_buffer, &context_gl->c) : NULL;
+    unsigned int base, count, i;
+
+    if (!data->swvp_constants)
+        GL_EXTCALL(glGenBuffers(1, &data->swvp_constants));
+    GL_EXTCALL(glBindBuffer(GL_UNIFORM_BUFFER, data->swvp_constants));
+    GL_EXTCALL(glBufferData(GL_UNIFORM_BUFFER, WINED3D_MAX_VS_CONSTS_F_SWVP * sizeof(struct wined3d_vec4),
+            constants, GL_STREAM_DRAW));
+    if (shader->load_local_constsF)
+    {
+        LIST_FOR_EACH_ENTRY(lconst, &shader->constantsF, struct wined3d_shader_lconst, entry)
+            GL_EXTCALL(glBufferSubData(GL_UNIFORM_BUFFER, lconst->idx * sizeof(struct wined3d_vec4),
+                    sizeof(struct wined3d_vec4), lconst->value));
+    }
+    wined3d_gl_limits_get_uniform_block_range(&gl_info->limits, WINED3D_SHADER_TYPE_VERTEX, &base, &count);
+    for (i = 0; i < 8; ++i)
+        GL_EXTCALL(glBindBufferRange(GL_UNIFORM_BUFFER, base + i, data->swvp_constants,
+                i * 16384, 16384));
+    checkGLcall("software vertex constants");
+}
