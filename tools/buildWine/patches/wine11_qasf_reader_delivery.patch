+/* A renderer may block Receive while paused. Deliver each output separately,
+ * so that video preroll cannot prevent the audio renderer from receiving data. */
+static DWORD WINAPI asf_stream_deliver(void *arg)
+{
+    struct asf_stream *stream = arg;
+    IMediaSample *sample;
+
+    EnterCriticalSection(&stream->delivery_cs);
+    while (!stream->delivery_stop)
+    {
+        if (!stream->pending_sample && !stream->eos)
+        {
+            SleepConditionVariableCS(&stream->delivery_cv, &stream->delivery_cs, INFINITE);
+            continue;
+        }
+        sample = stream->pending_sample;
+        stream->pending_sample = NULL;
+        stream->delivery_busy = TRUE;
+        if (!sample) stream->eos = FALSE;
+        WakeAllConditionVariable(&stream->delivery_cv);
+        LeaveCriticalSection(&stream->delivery_cs);
+
+        if (sample)
+        {
+            IMemInputPin_Receive(stream->source.pMemInputPin, sample);
+            IMediaSample_Release(sample);
+        }
+        else
+            IPin_EndOfStream(stream->source.pin.peer);
+
+        EnterCriticalSection(&stream->delivery_cs);
+        stream->delivery_busy = FALSE;
+        WakeAllConditionVariable(&stream->delivery_cv);
+    }
+    LeaveCriticalSection(&stream->delivery_cs);
+    return 0;
+}
+
+static void asf_reader_begin_flush(struct asf_reader *filter)
+{
+    UINT i;
+
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *stream = filter->streams + i;
+        EnterCriticalSection(&stream->delivery_cs);
+        stream->flushing = TRUE;
+        stream->eos = FALSE;
+        if (stream->pending_sample) IMediaSample_Release(stream->pending_sample);
+        stream->pending_sample = NULL;
+        WakeAllConditionVariable(&stream->delivery_cv);
+        LeaveCriticalSection(&stream->delivery_cs);
+        if (stream->source.pin.peer) IPin_BeginFlush(stream->source.pin.peer);
+    }
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *stream = filter->streams + i;
+        EnterCriticalSection(&stream->delivery_cs);
+        while (stream->delivery_busy)
+            SleepConditionVariableCS(&stream->delivery_cv, &stream->delivery_cs, INFINITE);
+        LeaveCriticalSection(&stream->delivery_cs);
+    }
+}
+
+static void asf_reader_end_flush(struct asf_reader *filter)
+{
+    UINT i;
+
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *stream = filter->streams + i;
+        if (stream->source.pin.peer) IPin_EndFlush(stream->source.pin.peer);
+        EnterCriticalSection(&stream->delivery_cs);
+        stream->flushing = FALSE;
+        LeaveCriticalSection(&stream->delivery_cs);
+    }
+}
+
+static void asf_reader_stop_delivery(struct asf_reader *filter)
+{
+    UINT i;
+
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *stream = filter->streams + i;
+        if (!stream->delivery_thread) continue;
+        EnterCriticalSection(&stream->delivery_cs);
+        stream->delivery_stop = TRUE;
+        WakeAllConditionVariable(&stream->delivery_cv);
+        LeaveCriticalSection(&stream->delivery_cs);
+        WaitForSingleObject(stream->delivery_thread, INFINITE);
+        CloseHandle(stream->delivery_thread);
+        stream->delivery_thread = NULL;
+    }
+}
