+static bool fold_pow(struct hlsl_ctx *ctx, struct hlsl_constant_value *dst,
+        const struct hlsl_type *dst_type, const struct hlsl_ir_constant *src1,
+        const struct hlsl_ir_constant *src2, const struct vkd3d_shader_location *loc)
+{
+    unsigned int k;
+
+    VKD3D_ASSERT(dst_type->e.numeric.type == src1->node.data_type->e.numeric.type);
+    VKD3D_ASSERT(dst_type->e.numeric.type == src2->node.data_type->e.numeric.type);
+
+    for (k = 0; k < dst_type->e.numeric.dimx; ++k)
+    {
+        switch (dst_type->e.numeric.type)
+        {
+            case HLSL_TYPE_FLOAT:
+            case HLSL_TYPE_HALF:
+                dst->u[k].f = powf(src1->value.u[k].f, src2->value.u[k].f);
+                if (!isfinite(dst->u[k].f))
+                    hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_NON_FINITE_RESULT,
+                            "Infinities and NaNs are not allowed by the shader model.");
+                break;
+
+            case HLSL_TYPE_DOUBLE:
+                dst->u[k].d = pow(src1->value.u[k].d, src2->value.u[k].d);
+                if (!isfinite(dst->u[k].d))
+                    hlsl_error(ctx, loc, VKD3D_SHADER_ERROR_HLSL_NON_FINITE_RESULT,
+                            "Infinities and NaNs are not allowed by the shader model.");
+                break;
+
+            default:
+                FIXME("Fold 'pow' for type %s.\n", debug_hlsl_type(ctx, dst_type));
+                return false;
+        }
+    }
+
+    return true;
+}
