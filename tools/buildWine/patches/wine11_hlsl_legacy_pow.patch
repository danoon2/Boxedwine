+/* Lower remaining nonconstant legacy POW expressions after folding. */
+static struct hlsl_ir_node *lower_pow(struct hlsl_ctx *ctx, struct hlsl_ir_node *instr, struct hlsl_block *block)
+{
+    struct hlsl_ir_node *log, *mul;
+    struct hlsl_ir_expr *expr;
+
+    if (instr->type != HLSL_IR_EXPR)
+        return NULL;
+    expr = hlsl_ir_expr(instr);
+    if (expr->op != HLSL_OP2_POW)
+        return NULL;
+
+    log = hlsl_block_add_unary_expr(ctx, block, HLSL_OP1_LOG2, expr->operands[0].node, &instr->loc);
+    mul = hlsl_block_add_binary_expr(ctx, block, HLSL_OP2_MUL, expr->operands[1].node, log);
+    return hlsl_block_add_unary_expr(ctx, block, HLSL_OP1_EXP2, mul, &instr->loc);
+}
