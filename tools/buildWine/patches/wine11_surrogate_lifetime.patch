+/* Revoke before the final check. CoRevokeClassObject serializes with class
+ * lookup, so any lookup which already obtained the wrapper has a reference
+ * by the time it returns. Marshalled DLL factories, objects and LockServer
+ * holds are accounted for by DllCanUnloadNow. */
+static BOOL surrogate_try_shutdown(struct surrogate *surrogate)
+{
+    struct factory *factory = impl_from_IClassFactory(surrogate->factory);
+    ULONG baseline = surrogate->cookie ? 2 : 1;
+    DWORD now = GetTickCount(), last_activity;
+    DWORD idle_delay = InterlockedCompareExchange(&factory->used, 0, 0) ? 5000 : 30000;
+    HRESULT hr;
+
+    if (!factory->can_unload) return FALSE;
+    if (InterlockedCompareExchange(&factory->ref, 0, 0) != baseline || factory->can_unload() != S_OK)
+    {
+        InterlockedExchange(&factory->last_activity, now);
+        return FALSE;
+    }
+    last_activity = InterlockedCompareExchange(&factory->last_activity, 0, 0);
+    if ((DWORD)(GetTickCount() - last_activity) < idle_delay) return FALSE;
+    if (surrogate->cookie)
+    {
+        if (FAILED(CoRevokeClassObject(surrogate->cookie))) return FALSE;
+        surrogate->cookie = 0;
+    }
+    if (InterlockedCompareExchange(&factory->ref, 0, 0) == 1 && factory->can_unload() == S_OK)
+    {
+        last_activity = InterlockedCompareExchange(&factory->last_activity, 0, 0);
+        if ((DWORD)(GetTickCount() - last_activity) >= idle_delay)
+        {
+            ISurrogate_FreeSurrogate(&surrogate->ISurrogate_iface);
+            return TRUE;
+        }
+    }
+
+    InterlockedExchange(&factory->last_activity, now);
+    hr = CoRegisterClassObject(&factory->clsid, (IUnknown *)&factory->IClassFactory_iface,
+                              CLSCTX_LOCAL_SERVER, REGCLS_SURROGATE, &surrogate->cookie);
+    if (FAILED(hr)) WARN("Failed to re-register active surrogate: %#lx\n", hr);
+    return FALSE;
+}
