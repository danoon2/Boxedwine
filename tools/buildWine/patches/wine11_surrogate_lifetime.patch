+/* Keep the module mapped while checking its unload contract, without keeping
+ * a class factory alive. A missing export/path is conservative: do not retire
+ * the surrogate automatically. CoGetClassObject still handles activation and
+ * apartment selection; this lookup never loads a different server. */
+static void factory_pin_module(struct factory *factory)
+{
+    WCHAR key[80], guid[39], *path;
+    ACTCTX_SECTION_KEYED_DATA data = { sizeof(data) };
+    CLSID redirect;
+    DWORD size = 0;
+
+    /* Registry paths cannot identify an activation-context or TreatAs server. */
+    if (CoGetTreatAsClass(&factory->clsid, &redirect) == S_OK
+        || FindActCtxSectionGuid(0, NULL, ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION,
+                                 &factory->clsid, &data)) return;
+
+    StringFromGUID2(&factory->clsid, guid, ARRAY_SIZE(guid));
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s\\InprocServer32", guid);
+    if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, NULL, &size)) return;
+    if (!(path = HeapAlloc(GetProcessHeap(), 0, size))) return;
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, path, &size)
+        && GetModuleHandleExW(0, path, &factory->module))
+        factory->can_unload = (void *)GetProcAddress(factory->module, "DllCanUnloadNow");
+    HeapFree(GetProcessHeap(), 0, path);
+}
