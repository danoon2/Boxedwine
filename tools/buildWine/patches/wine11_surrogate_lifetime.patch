+/* An idle local server may revoke its class after the SCM lookup but before
+ * QueryService. Retry stale registrations, without hiding real interface or
+ * activation errors. In-flight object calls are not retried. */
+HRESULT rpc_get_local_class_object(REFCLSID rclsid, REFIID riid, void **obj)
+{
+    HRESULT hr;
+    unsigned int tries;
+
+    for (tries = 0; tries < 3; ++tries)
+    {
+        hr = get_local_class_object(rclsid, riid, obj);
+        if (hr != REGDB_E_CLASSNOTREG && hr != CO_E_OBJNOTCONNECTED
+            && hr != RPC_E_DISCONNECTED && hr != RPC_E_INVALID_OBJREF
+            && hr != HRESULT_FROM_WIN32(RPC_S_SERVER_UNAVAILABLE)
+            && hr != HRESULT_FROM_WIN32(RPC_S_UNKNOWN_IF)
+            && hr != HRESULT_FROM_WIN32(RPC_S_CALL_FAILED)
+            && hr != HRESULT_FROM_WIN32(RPC_S_CALL_FAILED_DNE)
+            && hr != RPC_E_SERVER_DIED
+            && hr != RPC_E_SERVER_DIED_DNE) break;
+    }
+    return hr;
+}
